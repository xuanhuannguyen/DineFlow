                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                        <StackPanel Orientation="Horizontal">
                                            <Button Content="Quản lý kênh"
                                                    Click="btnManageChannels_Click"
                                                    MinWidth="132"
                                                    ToolTip="Xem danh sách và xóa kênh bán">
                                                <Button.ContentTemplate>
                                                    <DataTemplate>
                                                        <StackPanel Orientation="Horizontal">
                                                            <TextBlock Text="&#xE8D7;" FontFamily="Segoe Fluent Icons" FontSize="14" Margin="0 0 8 0"/>
                                                            <TextBlock Text="{Binding}"/>
                                                        </StackPanel>
                                                    </DataTemplate>
                                                </Button.ContentTemplate>
                                            </Button>
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                                            <Button Content="Đặt lại" Click="btnResetPricingWorkspace_Click" Margin="0 0 8 0"/>
                                            <Button Content="Lưu cấu hình" Style="{StaticResource PrimaryButtonStyle}" Click="btnSavePricingWorkspace_Click" MinWidth="140"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </Grid>
                        </Border>
                    </Grid>
                     
                </Grid>
            </Grid>
        </Grid>

        <Border x:Name="pnlDetailPane" Grid.Column="1" Background="#FFFFFF" BorderBrush="#E2E8F0"
                BorderThickness="1 0 0 0" Visibility="Collapsed">
            <Grid>
                <Grid.RowDefinitions><RowDefinition Height="74"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                <Border BorderBrush="#E2E8F0" BorderThickness="0 0 0 1" Padding="18 0">
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="CHI TIẾT &amp; THAO TÁC" Foreground="#646B62" FontSize="9" FontWeight="SemiBold"/>
                            <TextBlock x:Name="txtDetailHint" Text="Chọn một món để chỉnh sửa." Foreground="#475569" FontSize="12" Margin="0 5 0 0" TextTrimming="CharacterEllipsis"/>
                        </StackPanel>
                        <Button Grid.Column="1" Content="×" Width="34" Height="34" Padding="0" FontSize="18"
                                VerticalAlignment="Center" Click="btnCloseDetail_Click" ToolTip="Đóng bảng thao tác"/>
                    </Grid>
                </Border>

                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="18 8 18 18">
                    <Grid>
                        <StackPanel x:Name="pnlItemEditor" Visibility="Collapsed">
                            <Grid Margin="0 8 0 0">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>

                                <Border Grid.Column="0" Style="{StaticResource CardStyle}" CornerRadius="12" Padding="16" Margin="0 0 6 0">
                                    <StackPanel>
                                        <TextBlock Text="A. Thông tin cơ bản" Style="{StaticResource SectionTitleStyle}"/>
                                        <TextBlock Text="Thông tin khách nhìn thấy trên menu." Foreground="#64748B" FontSize="10" Margin="0 4 0 10"/>
                                        <Grid>
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="112"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                            <Border x:Name="brdImageDropZone" Width="104" Height="104" CornerRadius="10" Background="#F8FAFC"
                                                    BorderBrush="#CBD5E1" BorderThickness="1" AllowDrop="True"
                                                    PreviewDragOver="ImageDropZone_PreviewDragOver" Drop="ImageDropZone_Drop">
                                                <Grid ClipToBounds="True">
                                                    <Image x:Name="imgPreview" Stretch="UniformToFill"/>
                                                    <StackPanel x:Name="txtImageEmpty" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                        <TextBlock Text="&#xEB9F;" FontFamily="Segoe Fluent Icons" Foreground="#94A3B8" FontSize="24" HorizontalAlignment="Center"/>
                                                        <TextBlock Text="Thả ảnh" Foreground="#64748B" FontSize="10" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0 6 0 0"/>
                                                    </StackPanel>
                                                </Grid>
                                            </Border>
                                            <StackPanel Grid.Column="1">
                                                <Button Content="Chọn từ máy" Click="btnChooseImage_Click" Height="34" Margin="0 0 0 6"/>
                                                <Button Content="Xóa ảnh" Click="btnClearImage_Click" Height="34"/>
                                                <TextBlock Text="JPG, PNG · tối đa 2MB" Foreground="#64748B" FontSize="9" Margin="2 6 0 0"/>
                                            </StackPanel>
                                        </Grid>
                                        <TextBlock Text="Hoặc dùng URL ảnh bên ngoài" Style="{StaticResource FieldLabelStyle}" Margin="0 12 0 5"/>
                                        <Grid>
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                            <TextBox x:Name="txtImageUrl" ToolTip="Ví dụ: https://cdn.example.com/mon-an.jpg"/>
                                            <Button Grid.Column="1" Content="Xem thử" Click="btnPreviewImageUrl_Click" Height="40" Margin="7 0 0 0" Padding="12 5"/>
                                        </Grid>
                                        <TextBlock x:Name="txtImageStatus" Text="Dán URL bắt đầu bằng http:// hoặc https://"
                                                   Foreground="#64748B" FontSize="9" Margin="2 5 0 0" TextWrapping="Wrap"/>
                                        <Grid>
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                            <StackPanel Margin="0 0 5 0"><TextBlock Text="Mã món" Style="{StaticResource FieldLabelStyle}"/><TextBox x:Name="txtItemCode" CharacterCasing="Upper" Foreground="#0866E5" FontWeight="SemiBold"/></StackPanel>
                                            <StackPanel Grid.Column="1" Margin="5 0 0 0"><TextBlock Text="Danh mục" Style="{StaticResource FieldLabelStyle}"/><ComboBox x:Name="cboCategory" DisplayMemberPath="CategoryName" SelectedValuePath="CategoryId"/></StackPanel>
                                        </Grid>
                                        <TextBlock Text="Tên món" Style="{StaticResource FieldLabelStyle}"/><TextBox x:Name="txtItemName"/>
                                        <TextBlock Text="Mô tả ngắn" Style="{StaticResource FieldLabelStyle}"/><TextBox x:Name="txtDescription" Height="68" TextWrapping="Wrap" AcceptsReturn="True" VerticalContentAlignment="Top"/>
                                    </StackPanel>
                                </Border>

                                <StackPanel Grid.Column="1" Margin="6 0 0 0">
                                    <Border Style="{StaticResource CardStyle}" CornerRadius="12" Padding="16">
                                        <StackPanel>
                                            <TextBlock Text="B. Giá &amp; trạng thái bán" Style="{StaticResource SectionTitleStyle}"/>
                                            <TextBlock Text="Giá tại quán" Style="{StaticResource FieldLabelStyle}"/><TextBox x:Name="txtPrice"/>
                                            <UniformGrid Columns="2" Margin="0 12 0 0">
                                                <CheckBox x:Name="chkIsAvailable" Content="Đang bán"/>
                                                <CheckBox x:Name="chkTrackStock" Content="Theo dõi tồn" Checked="chkTrackStock_Changed" Unchecked="chkTrackStock_Changed"/>
                                            </UniformGrid>
                                            <TextBlock Text="Lý do tạm ngưng" Style="{StaticResource FieldLabelStyle}"/><TextBox x:Name="txtItemSoldOutReason"/>
                                        </StackPanel>
                                    </Border>
                                    <Border Style="{StaticResource CardStyle}" CornerRadius="12" Padding="16" Margin="0 12 0 0">
                                        <StackPanel>
                                            <TextBlock Text="C. Tồn kho" Style="{StaticResource SectionTitleStyle}"/>
                                            <TextBlock Text="Số lượng hiện có" Style="{StaticResource FieldLabelStyle}"/><TextBox x:Name="txtAvailableQuantity"/>
                                            <TextBlock x:Name="txtStockSuggestion" Foreground="#D97706" FontSize="10" Margin="0 6 0 0" TextWrapping="Wrap"/>
                                            <TextBlock Text="Ghi chú nội bộ" Style="{StaticResource FieldLabelStyle}"/><TextBox x:Name="txtItemStaffNote"/>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </Grid>

                            <Border Background="#F0F7FF" BorderBrush="#D1E9FF" BorderThickness="1"
                                    CornerRadius="12" Padding="16" Margin="0 12 0 0">
                                <StackPanel>
                                    <Grid Margin="0 0 0 10">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="D. Nhóm lựa chọn áp dụng" Foreground="#0F172A" FontSize="15" FontWeight="SemiBold"/>
                                            <TextBlock Text="Bật nhóm và sắp thứ tự khách sẽ thấy." Foreground="#475569" FontSize="10" Margin="0 4 0 0"/>
                                        </StackPanel>
                                        <Button Grid.Column="1" Content="+ Nhóm mới" Click="OpenNewChoiceGroup_Click" Height="34" Padding="12 2"/>
                                    </Grid>
                                    <ListBox x:Name="lstItemChoiceGroups" Background="Transparent" BorderThickness="0"
                                             MaxHeight="300" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                        <ListBox.ItemContainerStyle>
                                            <Style TargetType="ListBoxItem">
                                                <Setter Property="Padding" Value="0"/>
                                                <Setter Property="Margin" Value="0 0 0 9"/>
                                                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                                <Setter Property="Background" Value="Transparent"/>
                                                <Setter Property="BorderThickness" Value="0"/>
                                            </Style>
                                        </ListBox.ItemContainerStyle>
                                        <ListBox.ItemTemplate>
                                            <DataTemplate>
                                                <Border Background="#FFFFFF" BorderBrush="#D1E9FF" BorderThickness="1" CornerRadius="10" Padding="12">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions><ColumnDefinition Width="28"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                                        <CheckBox IsChecked="{Binding IsAssigned, Mode=OneTime}" IsEnabled="{Binding CanManage}"
                                                                  Tag="{Binding}" Click="ChoiceGroupAssignment_Click" VerticalAlignment="Center"/>
                                                        <StackPanel Grid.Column="1" Margin="8 0 12 0">
                                                            <TextBlock Text="{Binding GroupName}" Foreground="#1E293B" FontWeight="SemiBold" FontSize="14"/>
                                                            <TextBlock Text="{Binding RuleText}" Foreground="#64748B" FontSize="11" Margin="0 4 0 0"/>
                                                        </StackPanel>
                                                        <StackPanel Grid.Column="2" Orientation="Horizontal">
                                                            <Button Content="↑" Tag="{Binding}" Click="MoveChoiceGroupUp_Click"
                                                                    IsEnabled="{Binding IsAssigned}" Width="36" Height="34" Padding="0" ToolTip="Đưa nhóm lên trên"/>
                                                            <Button Content="↓" Tag="{Binding}" Click="MoveChoiceGroupDown_Click"
                                                                    IsEnabled="{Binding IsAssigned}" Width="36" Height="34" Padding="0" Margin="6 0" ToolTip="Đưa nhóm xuống dưới"/>
                                                            <Button Content="Sửa" Tag="{Binding Source}"
                                                                    Click="OpenChoiceGroup_Click" Height="34" Padding="14 2"/>
                                                        </StackPanel>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>
                                </StackPanel>
                            </Border>
                            <Border Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="1 1 1 0" CornerRadius="12 12 0 0" Padding="12" Margin="0 12 0 0">
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <StackPanel Orientation="Horizontal">
                                        <Button x:Name="btnReopenItem" Content="Mở bán" Style="{StaticResource SuccessButtonStyle}" Click="btnSelectedItemEnableSale_Click" Margin="0 0 6 0"/>
                                        <Button x:Name="btnSoldOutItem" Content="Tạm ngưng" Style="{StaticResource WarningButtonStyle}" Click="btnSelectedItemMarkSoldOut_Click" Margin="0 0 6 0"/>
                                        <Button x:Name="btnHideItem" Content="Ẩn món" Style="{StaticResource DangerButtonStyle}" Click="btnSoftDelete_Click"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2" Orientation="Horizontal">
                                        <Button x:Name="btnItemReset" Content="Nhập lại" Click="btnClear_Click" Margin="0 0 6 0"/>
                                        <Button x:Name="btnSaveItem" Content="Lưu món" Style="{StaticResource PrimaryButtonStyle}" Click="btnSaveItem_Click" Margin="0 0 6 0"/>
                                        <Button x:Name="btnSaveAndConfigureChoices" Content="Lưu &amp; cấu hình lựa chọn"
                                                Style="{StaticResource PrimaryButtonStyle}" Click="btnSaveAndConfigureChoices_Click"
                                                ToolTip="Lưu món rồi chuyển thẳng sang bước tạo size, topping và món ăn kèm"/>
                                    </StackPanel>
                                    <UniformGrid x:Name="pnlItemActionGrid" Visibility="Collapsed"/>
                                </Grid>
                            </Border>
                        </StackPanel>

                        <StackPanel x:Name="pnlCategoryEditor" Visibility="Collapsed">
                            <TextBlock Text="Tên danh mục" Style="{StaticResource FieldLabelStyle}"/><TextBox x:Name="txtCategoryName"/>
                            <TextBlock Text="Mô tả" Style="{StaticResource FieldLabelStyle}"/><TextBox x:Name="txtCategoryDescription" Height="72" TextWrapping="Wrap" AcceptsReturn="True" VerticalContentAlignment="Top"/>
                            <TextBlock Text="Thứ tự hiển thị" Style="{StaticResource FieldLabelStyle}"/><TextBox x:Name="txtCategoryDisplayOrder"/>
                            <UniformGrid x:Name="pnlCategoryActionGrid" Columns="2" Margin="0 16 0 0">
                                <Button x:Name="btnCreateCategory" Content="Tạo mới" Style="{StaticResource PrimaryButtonStyle}" Click="btnCategoryCreate_Click" Margin="3"/>
                                <Button x:Name="btnUpdateCategory" Content="Cập nhật" Click="btnCategoryUpdate_Click" Margin="3"/>
                                <Button x:Name="btnHideCategory" Content="Xóa" Style="{StaticResource DangerButtonStyle}" Click="btnCategorySoftDelete_Click" Margin="3"/>
                            </UniformGrid>
                            <Button x:Name="btnCategoryReset" Content="Nhập lại" Click="btnCategoryClear_Click" Margin="0 12 0 0"/>
                        </StackPanel>

                        <StackPanel x:Name="pnlAddonEditor" Visibility="Collapsed">
                            <Border x:Name="pnlAddonGroupEditor" Visibility="Collapsed" Background="{StaticResource PanelStrongBrush}" BorderBrush="{StaticResource PanelBorderBrush}" BorderThickness="1" CornerRadius="10" Padding="16" Margin="0 8 0 2">
                                <StackPanel>
                                    <TextBlock Text="01. Nhóm lựa chọn" Style="{StaticResource SectionTitleStyle}" Margin="0 0 0 10"/>
                                    <TextBlock Text="Tạo, chỉnh sửa nhóm lựa chọn cho món đã chọn. Các nhóm này xác định số lượng tối thiểu / tối đa và trạng thái bắt buộc." Foreground="#7F8995" FontSize="11" TextWrapping="Wrap" Margin="0 0 0 14"/>
                                    <TextBlock Text="Tên nhóm lựa chọn" Style="{StaticResource FieldLabelStyle}"/>
                                    <TextBox x:Name="txtAddonGroupName"/>
                                    <Grid Margin="0 12 0 0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" Margin="0 0 10 0"><TextBlock Text="Chọn tối thiểu" Style="{StaticResource FieldLabelStyle}" Margin="0 0 0 6"/><TextBox x:Name="txtAddonMinSelect"/></StackPanel>
                                        <StackPanel Grid.Column="1" Margin="0 0 10 0"><TextBlock Text="Chọn tối đa" Style="{StaticResource FieldLabelStyle}" Margin="0 0 0 6"/><TextBox x:Name="txtAddonMaxSelect"/></StackPanel>
                                        <StackPanel Grid.Column="2"><TextBlock Text="Thứ tự" Style="{StaticResource FieldLabelStyle}" Margin="0 0 0 6"/><TextBox x:Name="txtAddonGroupOrder"/></StackPanel>
                                    </Grid>
                                    <StackPanel Orientation="Horizontal" Margin="0 14 0 0">
                                        <CheckBox x:Name="chkAddonGroupRequired" Content="Bắt buộc chọn" Checked="AddonRequired_Changed" Unchecked="AddonRequired_Changed" Margin="0 0 20 0"/>
                                        <CheckBox x:Name="chkAddonGroupActive" Content="Đang hoạt động"/>
                                    </StackPanel>
                                    <Border Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="10" Padding="12" Margin="0 16 0 0">
                                        <StackPanel>
                                            <Grid Margin="0 0 0 8">
                                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                                <TextBlock Text="Món đang áp dụng" Foreground="#1E293B" FontWeight="SemiBold"/>
                                                <TextBlock x:Name="txtGlobalAppliedCount" Grid.Column="1" Text="0 món" Foreground="#0866E5" FontSize="10" VerticalAlignment="Center"/>
                                            </Grid>
                                            <ListBox x:Name="lstGlobalAppliedItems" MaxHeight="150" Background="Transparent" BorderThickness="0"
                                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                                <ListBox.ItemContainerStyle>
                                                    <Style TargetType="ListBoxItem"><Setter Property="Padding" Value="0"/><Setter Property="Margin" Value="0 0 0 5"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/></Style>
                                                </ListBox.ItemContainerStyle>
                                                <ListBox.ItemTemplate>
                                                    <DataTemplate>
                                                        <Grid>
                                                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                                            <TextBlock Text="{Binding ItemName}" Foreground="#334155" FontSize="11" TextTrimming="CharacterEllipsis"/>
                                                            <TextBlock Grid.Column="1" Text="{Binding CategoryName}" Foreground="#64748B" FontSize="9" Margin="8 0 0 0"/>
                                                        </Grid>
                                                    </DataTemplate>
                                                </ListBox.ItemTemplate>
                                            </ListBox>
                                            <TextBlock x:Name="txtGlobalAppliedEmpty" Text="Nhóm này chưa được gắn vào món nào."
                                                       Foreground="#64748B" FontSize="10" FontStyle="Italic"/>
                                        </StackPanel>
                                    </Border>
                                    <StackPanel Orientation="Horizontal" Margin="0 18 0 0">
                                        <Button x:Name="btnAddAddonGroup" Content="Thêm nhóm" Style="{StaticResource PrimaryButtonStyle}" Click="btnAddAddonGroup_Click" Width="140" Margin="0 0 10 0"/>
                                        <Button x:Name="btnUpdateAddonGroup" Content="Cập nhật nhóm" Click="btnUpdateAddonGroup_Click" Width="140"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                            <Border x:Name="pnlAddonChoiceEditor" Visibility="Collapsed" Background="{StaticResource PanelStrongBrush}" BorderBrush="{StaticResource PanelBorderBrush}" BorderThickness="1" CornerRadius="10" Padding="16" Margin="0 8 0 6">
                                <StackPanel>
                                    <TextBlock Text="02. Lựa chọn" Style="{StaticResource SectionTitleStyle}" Margin="0 0 0 10"/>
                                    <TextBlock x:Name="txtChoiceEditorMode" Text="Tạo lựa chọn mới" Foreground="#1E293B" FontWeight="SemiBold" Margin="0 0 0 8"/>
                                    <TextBlock Text="Thêm hoặc chỉnh sửa lựa chọn trong nhóm đã chọn. Chọn loại lựa chọn phù hợp rồi nhập tên và giá." Foreground="#7F8995" FontSize="11" TextWrapping="Wrap" Margin="0 0 0 14"/>
                                    <StackPanel Orientation="Horizontal" Margin="0 0 0 14">
                                        <RadioButton x:Name="rbCustomChoice" GroupName="ChoiceMode" Content="Lựa chọn thường" IsChecked="True" Checked="ChoiceMode_Changed" Foreground="#1E293B" Margin="0 0 24 0"/>
                                        <RadioButton x:Name="rbLinkedChoice" GroupName="ChoiceMode" Content="Liên kết món có sẵn" Checked="ChoiceMode_Changed" Foreground="#1E293B"/>
                                    </StackPanel>
                                    <Border x:Name="pnlCustomChoice" Background="#F8FAFC" BorderBrush="{StaticResource PanelBorderBrush}" BorderThickness="1" CornerRadius="10" Padding="12" Margin="0 0 0 12">
                                        <StackPanel>
                                            <TextBlock Text="Dùng cho size, khẩu phần, độ cay…" Foreground="#8D948A" FontSize="10" Margin="0 0 0 10"/>
                                            <TextBlock Text="Tên lựa chọn" Style="{StaticResource FieldLabelStyle}" Margin="0 0 0 6"/>
                                            <TextBox x:Name="txtCustomChoiceName"/>
                                            <TextBlock Text="Không quản lý stock riêng; chỉ lưu tên và giá cộng thêm." Foreground="#666D64" FontSize="9" Margin="6 6 0 0" TextWrapping="Wrap"/>
                                        </StackPanel>
                                    </Border>
                                    <Border x:Name="pnlLinkedChoice" Visibility="Collapsed" Background="#F8FAFC" BorderBrush="{StaticResource PanelBorderBrush}" BorderThickness="1" CornerRadius="10" Padding="12" Margin="0 0 0 12">
                                        <StackPanel>
                                            <TextBlock Text="Liên kết lựa chọn với một món đang có để dùng chung tồn kho và trạng thái bán." Foreground="#8D948A" FontSize="10" Margin="0 0 0 10" TextWrapping="Wrap"/>
                                            <TextBlock Text="Tìm món liên kết" Style="{StaticResource FieldLabelStyle}" Margin="0 0 0 6"/>
                                            <TextBox x:Name="txtLinkedItemSearch" TextChanged="txtLinkedItemSearch_TextChanged" Margin="0 0 0 8"
                                                     ToolTip="Tìm theo mã món, tên món hoặc danh mục"/>
                                            <ListBox x:Name="lstAddonMenuItems" Height="210" SelectionMode="Single" SelectionChanged="lstAddonMenuItems_SelectionChanged"
                                                     Background="#FFFFFF" Foreground="#1E293B" BorderBrush="{StaticResource PanelBorderBrush}" BorderThickness="1">
                                                <ListBox.ItemContainerStyle>
                                                    <Style TargetType="ListBoxItem">
                                                        <Setter Property="Padding" Value="9 7"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="Background" Value="Transparent"/>
                                                        <Style.Triggers>
                                                            <Trigger Property="IsSelected" Value="True"><Setter Property="Background" Value="#D1E9FF"/><Setter Property="Foreground" Value="#0B55A0"/></Trigger>
                                                            <Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="#F0F7FF"/></Trigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </ListBox.ItemContainerStyle>
                                                <ListBox.ItemTemplate>
                                                    <DataTemplate>
                                                        <Grid>
                                                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                                            <StackPanel>
                                                                <StackPanel Orientation="Horizontal">
                                                                    <TextBlock Text="{Binding ItemCode}" Foreground="#0866E5" FontWeight="SemiBold" FontSize="10" Margin="0 0 7 0"/>
                                                                    <TextBlock Text="{Binding ItemName}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                                                </StackPanel>
                                                                <TextBlock Text="{Binding CategoryName}" Foreground="#737A71" FontSize="10" Margin="0 3 0 0"/>
                                                            </StackPanel>
                                                            <TextBlock Grid.Column="1" Text="{Binding Price, StringFormat={}{0:N0} ₫}" Foreground="#0B55A0" FontSize="10" VerticalAlignment="Center" Margin="8 0 0 0"/>
                                                        </Grid>
                                                    </DataTemplate>
                                                </ListBox.ItemTemplate>
                                            </ListBox>
                                            <TextBlock x:Name="txtLinkedItemSelection" Text="Chưa chọn món liên kết" Foreground="#7F8995" FontSize="10" Margin="2 8 0 0" TextWrapping="Wrap"/>
                                        </StackPanel>
                                    </Border>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" Margin="0 0 10 0"><TextBlock Text="Giá cộng thêm" Style="{StaticResource FieldLabelStyle}" Margin="0 0 0 6"/><TextBox x:Name="txtExtraPriceOverride"/></StackPanel>
                                        <StackPanel Grid.Column="1"><TextBlock Text="Thứ tự" Style="{StaticResource FieldLabelStyle}" Margin="0 0 0 6"/><TextBox x:Name="txtAddonOptionOrder"/></StackPanel>
                                    </Grid>
                                    <CheckBox x:Name="chkAddonOptionDefault" Content="Lựa chọn mặc định" Visibility="Collapsed" Margin="0 12 0 0"/>
                                    <StackPanel Orientation="Horizontal" Margin="0 18 0 0">
                                        <Button x:Name="btnNewChoiceVisible" Content="+ Tạo lựa chọn mới" Style="{StaticResource PrimaryButtonStyle}" Click="btnNewChoice_Click" Width="150" Margin="0 0 10 0"/>
                                        <Button x:Name="btnUpdateAddonOption" Content="Lưu lựa chọn" Style="{StaticResource PrimaryButtonStyle}" Click="btnSaveChoice_Click" Width="150" Margin="0 0 10 0"/>
                                        <Button x:Name="btnHideAddonOption" Content="Xóa lựa chọn" Style="{StaticResource DangerButtonStyle}" Click="btnHideAddonOption_Click" Width="130"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </StackPanel>

                    </Grid>
                </ScrollViewer>
            </Grid>
        </Border>
    </Grid>
</UserControl>
