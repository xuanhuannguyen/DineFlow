                                        <TextBlock Text="&#xE721;" FontFamily="Segoe Fluent Icons" Foreground="#7E8995"
                                                   FontSize="14" Margin="12 0 0 0" HorizontalAlignment="Left" VerticalAlignment="Center" IsHitTestVisible="False"/>
                                        <TextBlock Text="Nhập mã món, tên món hoặc danh mục..." Foreground="#68727D" FontSize="12"
                                                   Margin="36 0 0 0" VerticalAlignment="Center" IsHitTestVisible="False">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                    <Style.Triggers>
