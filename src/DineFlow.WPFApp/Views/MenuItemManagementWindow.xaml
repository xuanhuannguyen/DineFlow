<UserControl x:Class="DineFlow.WPFApp.Views.MenuItemManagementWindow"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#F4F7FB"
             FontFamily="Segoe UI Variable Text"
             TextOptions.TextFormattingMode="Display"
             UseLayoutRounding="True">
    <UserControl.Resources>
        <SolidColorBrush x:Key="InkBrush" Color="#0F172A"/>
        <SolidColorBrush x:Key="MutedBrush" Color="#64748B"/>
        <SolidColorBrush x:Key="PanelBrush" Color="#F8FAFC"/>
        <SolidColorBrush x:Key="PanelStrongBrush" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="PanelBorderBrush" Color="#E2E8F0"/>
        <SolidColorBrush x:Key="AccentBrush" Color="#0866E5"/>
        <SolidColorBrush x:Key="SuccessBrush" Color="#16A34A"/>
        <SolidColorBrush x:Key="WarningBrush" Color="#D97706"/>

        <Style x:Key="CardStyle" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource PanelStrongBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource PanelBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="16"/>
            <Setter Property="Padding" Value="18"/>
        </Style>

        <Style x:Key="SectionTitleStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource InkBrush}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="15"/>
        </Style>

        <Style x:Key="FieldLabelStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#475569"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0 14 0 6"/>
        </Style>

        <Style TargetType="TextBox">
            <Setter Property="Height" Value="40"/>
            <Setter Property="Padding" Value="11 6"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="#1E293B"/>
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="BorderBrush" Value="#CBD5E1"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CaretBrush" Value="#0866E5"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="SelectionBrush" Value="#BFDBFE"/>
        </Style>

        <Style TargetType="ComboBox">
            <Setter Property="Height" Value="40"/>
            <Setter Property="Padding" Value="11 4"/>
            <Setter Property="Foreground" Value="#1E293B"/>
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="BorderBrush" Value="#CBD5E1"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton x:Name="ToggleButton" Focusable="False"
                                          IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}"
                                          Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                          BorderThickness="1" Cursor="Hand">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border x:Name="ComboBorder" Background="{TemplateBinding Background}"
                                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                                                CornerRadius="5">
                                            <Grid>
                                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="34"/></Grid.ColumnDefinitions>
                                                <ContentPresenter Grid.Column="0" Margin="11 0 5 0" VerticalAlignment="Center"
                                                                  HorizontalAlignment="Left" Content="{Binding SelectionBoxItem, RelativeSource={RelativeSource AncestorType=ComboBox}}"
                                                                  ContentTemplate="{Binding SelectionBoxItemTemplate, RelativeSource={RelativeSource AncestorType=ComboBox}}"/>
                                                <Border Grid.Column="1" BorderBrush="#E2E8F0" BorderThickness="1 0 0 0">
                                                    <TextBlock Text="⌄" Foreground="#64748B" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                            </Grid>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="ComboBorder" Property="BorderBrush" Value="#0B84F3"/></Trigger>
                                            <Trigger Property="IsChecked" Value="True"><Setter TargetName="ComboBorder" Property="BorderBrush" Value="#0866E5"/></Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>
                            <Popup x:Name="Popup" IsOpen="{TemplateBinding IsDropDownOpen}" Placement="Bottom"
                                   AllowsTransparency="True" Focusable="False" PopupAnimation="Fade">
                                <Border MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}"
                                        MaxHeight="280" Background="#FFFFFF" BorderBrush="#D1E9FF" BorderThickness="1"
                                        CornerRadius="5" Margin="0 4 0 0" Padding="3">
                                    <ScrollViewer VerticalScrollBarVisibility="Auto"><ItemsPresenter/></ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ComboBoxItem">
            <Setter Property="Foreground" Value="#1E293B"/>
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="Padding" Value="11 9"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Style.Triggers>
                <Trigger Property="IsHighlighted" Value="True"><Setter Property="Background" Value="#F0F7FF"/><Setter Property="Foreground" Value="#0B55A0"/></Trigger>
                <Trigger Property="IsSelected" Value="True"><Setter Property="Background" Value="#D1E9FF"/><Setter Property="Foreground" Value="#0B55A0"/></Trigger>
            </Style.Triggers>
        </Style>

        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="#475569"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Margin" Value="0 4"/>
        </Style>

        <Style TargetType="Button">
            <Setter Property="Height" Value="40"/>
            <Setter Property="Padding" Value="13 5"/>
            <Setter Property="Foreground" Value="#475569"/>
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="BorderBrush" Value="#CBD5E1"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBorder" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="#F0F7FF"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Opacity" Value=".78"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="ButtonBorder" Property="Opacity" Value=".35"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PrimaryButtonStyle" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="#0B84F3"/>
            <Setter Property="BorderBrush" Value="#0B84F3"/>
            <Setter Property="Foreground" Value="White"/>
        </Style>
        <Style x:Key="SuccessButtonStyle" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="#F0FDF4"/>
            <Setter Property="BorderBrush" Value="#DCFCE7"/>
            <Setter Property="Foreground" Value="#16A34A"/>
        </Style>
        <Style x:Key="WarningButtonStyle" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="#FFF7ED"/>
            <Setter Property="BorderBrush" Value="#FFD8A8"/>
            <Setter Property="Foreground" Value="#D97706"/>
        </Style>
        <Style x:Key="DangerButtonStyle" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="#FEF2F2"/>
            <Setter Property="BorderBrush" Value="#FECACA"/>
            <Setter Property="Foreground" Value="#EF4444"/>
        </Style>

        <Style TargetType="DataGrid">
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="Foreground" Value="#1E293B"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="RowBackground" Value="#FFFFFF"/>
            <Setter Property="AlternatingRowBackground" Value="#F8FAFC"/>
            <Setter Property="HorizontalGridLinesBrush" Value="#E2E8F0"/>
            <Setter Property="VerticalGridLinesBrush" Value="Transparent"/>
            <Setter Property="GridLinesVisibility" Value="Horizontal"/>
            <Setter Property="HeadersVisibility" Value="Column"/>
            <Setter Property="CanUserAddRows" Value="False"/>
            <Setter Property="CanUserDeleteRows" Value="False"/>
            <Setter Property="SelectionMode" Value="Single"/>
            <Setter Property="SelectionUnit" Value="FullRow"/>
            <Setter Property="RowHeight" Value="56"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="AutoGenerateColumns" Value="False"/>
        </Style>
        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Height" Value="40"/>
            <Setter Property="Background" Value="#F8FAFC"/>
            <Setter Property="Foreground" Value="#64748B"/>
            <Setter Property="BorderBrush" Value="#E2E8F0"/>
            <Setter Property="BorderThickness" Value="0 0 0 1"/>
            <Setter Property="Padding" Value="9 0"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
        <Style TargetType="DataGridRow">
            <Setter Property="BorderThickness" Value="0"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="#F0F7FF"/></Trigger>
                <Trigger Property="IsSelected" Value="True"><Setter Property="Background" Value="#D1E9FF"/><Setter Property="Foreground" Value="#0B55A0"/></Trigger>
            </Style.Triggers>
        </Style>
        <Style TargetType="DataGridCell">
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="9 0"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#D1E9FF"/>
                    <Setter Property="Foreground" Value="#0B55A0"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <DataTemplate x:Key="BadgeTemplate">
            <Border CornerRadius="9" Padding="8 3" Background="{Binding BadgeBackground}" HorizontalAlignment="Left">
                <TextBlock Text="{Binding BadgeText}" Foreground="{Binding BadgeForeground}" FontWeight="SemiBold" FontSize="10"/>
            </Border>
        </DataTemplate>
    </UserControl.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition x:Name="detailColumn" Width="0"/>
        </Grid.ColumnDefinitions>

        <Grid Grid.Column="0" Margin="24 0 20 22">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Grid Margin="0 14 0 12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="104"/>
                    <ColumnDefinition Width="104"/>
                    <ColumnDefinition Width="104"/>
                    <ColumnDefinition Width="104"/>
                </Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="DINEFLOW  /  QUẢN LÝ MENU" Foreground="#707A86" FontSize="10" FontWeight="SemiBold"/>
                    <StackPanel Orientation="Horizontal" Margin="0 5 0 0">
                        <TextBlock Text="🍴" FontSize="15" Margin="0 0 7 0"/>
                        <TextBlock x:Name="txtScreenTitle" Text="Tổng quan" Foreground="{StaticResource InkBrush}"
                                   FontWeight="Bold" FontSize="21"/>
                    </StackPanel>
                    <TextBlock x:Name="txtScreenSubtitle" Text="Theo dõi vận hành menu trong một màn hình."
                               Foreground="{StaticResource MutedBrush}" FontSize="12" Margin="0 5 0 0"/>
                </StackPanel>

                <Border Grid.Column="1" Style="{StaticResource CardStyle}" Padding="11 8" Margin="0 0 7 0" CornerRadius="11">
                    <StackPanel><TextBlock Text="Tổng món" Foreground="#64748B" FontSize="9"/><TextBlock x:Name="txtStatMenuItems" Text="0" Foreground="#0F172A" FontSize="18" FontWeight="Bold"/></StackPanel>
                </Border>
                <Border Grid.Column="2" Style="{StaticResource CardStyle}" Padding="11 8" Margin="0 0 7 0" CornerRadius="11">
                    <StackPanel><TextBlock Text="Đang bán" Foreground="#64748B" FontSize="9"/><TextBlock x:Name="txtStatAvailable" Text="0" Foreground="#16A34A" FontSize="18" FontWeight="Bold"/></StackPanel>
                </Border>
                <Border Grid.Column="3" Style="{StaticResource CardStyle}" Padding="11 8" Margin="0 0 7 0" CornerRadius="11">
                    <StackPanel><TextBlock Text="Sắp hết" Foreground="#64748B" FontSize="9"/><TextBlock x:Name="txtStatSoldOut" Text="0" Foreground="#D97706" FontSize="18" FontWeight="Bold"/></StackPanel>
                </Border>
                <Border Grid.Column="4" Style="{StaticResource CardStyle}" Padding="11 8" CornerRadius="11">
                    <StackPanel><TextBlock Text="Danh mục" Foreground="#64748B" FontSize="9"/><TextBlock x:Name="txtStatCategories" Text="0" Foreground="#0F172A" FontSize="18" FontWeight="Bold"/></StackPanel>
                </Border>
            </Grid>

            <Border Grid.Row="1" Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="1"
                    CornerRadius="12" Padding="6" Margin="0 0 0 12">
                <Grid>
                    <UniformGrid Columns="5">
                        <Button x:Name="btnFlowCategories" Click="ShowCategories_Click" Height="40" Margin="0 0 3 0">
                            <StackPanel Orientation="Horizontal"><TextBlock Text="01" FontSize="11" FontWeight="Bold" VerticalAlignment="Center" Margin="0 0 8 0"/><TextBlock Text="Danh mục" FontSize="13" VerticalAlignment="Center"/></StackPanel>
                        </Button>
                        <Button x:Name="btnFlowItems" Click="ShowMenuItems_Click" Height="40" Margin="3 0">
                            <StackPanel Orientation="Horizontal"><TextBlock Text="02" FontSize="11" FontWeight="Bold" VerticalAlignment="Center" Margin="0 0 8 0"/><TextBlock Text="Món ăn" FontSize="13" VerticalAlignment="Center"/></StackPanel>
                        </Button>
                        <Button x:Name="btnFlowChoices" Click="ShowAddons_Click" Height="40" Margin="3 0">
                            <StackPanel Orientation="Horizontal"><TextBlock Text="03" FontSize="11" FontWeight="Bold" VerticalAlignment="Center" Margin="0 0 8 0"/><TextBlock Text="Lựa chọn" FontSize="13" VerticalAlignment="Center"/></StackPanel>
                        </Button>
                        <Button x:Name="btnFlowStock" Click="ShowStock_Click" Height="40" Margin="3 0">
                            <StackPanel Orientation="Horizontal"><TextBlock Text="04" FontSize="11" FontWeight="Bold" VerticalAlignment="Center" Margin="0 0 8 0"/><TextBlock Text="Tồn kho" FontSize="13" VerticalAlignment="Center"/></StackPanel>
                        </Button>
                        <Button x:Name="btnFlowPricing" Click="ShowPricing_Click" Height="40" Margin="3 0 0 0">
                            <StackPanel Orientation="Horizontal"><TextBlock Text="05" FontSize="11" FontWeight="Bold" VerticalAlignment="Center" Margin="0 0 8 0"/><TextBlock Text="Giá kênh" FontSize="13" VerticalAlignment="Center"/></StackPanel>
                        </Button>
                    </UniformGrid>
                </Grid>
            </Border>

            <Grid Grid.Row="2">
                <Grid x:Name="pnlDashboard">
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                    <Grid Margin="0 0 0 8">
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="Tất cả món ăn" Style="{StaticResource SectionTitleStyle}"/>
                            <TextBlock x:Name="txtDashboardMenuSummary" Foreground="#89929D" FontSize="11" Margin="0 4 0 0"/>
                        </StackPanel>
                    </Grid>

                    <Border Grid.Row="1" Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="11" Padding="12" Margin="0 0 0 10">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="2*"/>
                                <ColumnDefinition Width="190"/>
                                <ColumnDefinition Width="150"/>
                                <ColumnDefinition Width="160"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Margin="0 0 8 0">
                                <TextBlock Text="Tìm món" Foreground="#64748B" FontSize="9" FontWeight="SemiBold" Margin="0 0 0 4"/>
                                <Grid>
                                    <TextBox x:Name="txtDashboardSearch" TextChanged="DashboardFilter_Changed" Padding="34 6 10 6" ToolTip="Tìm theo mã món, tên món hoặc danh mục"/>
                                    <TextBlock Text="&#xE721;" FontFamily="Segoe Fluent Icons" Foreground="#94A3B8" Margin="11 0 0 0" HorizontalAlignment="Left" VerticalAlignment="Center" IsHitTestVisible="False"/>
                                    <TextBlock Text="Nhập mã hoặc tên món..." Foreground="#94A3B8" FontSize="11" Margin="34 0 0 0" VerticalAlignment="Center" IsHitTestVisible="False">
                                        <TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding Text, ElementName=txtDashboardSearch}" Value=""><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style>
                                    </TextBlock>
                                </Grid>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Margin="0 0 8 0">
                                <TextBlock Text="Danh mục" Foreground="#64748B" FontSize="9" FontWeight="SemiBold" Margin="0 0 0 4"/>
                                <ComboBox x:Name="cboDashboardCategoryFilter" SelectionChanged="DashboardFilter_Changed"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2" Margin="0 0 8 0">
                                <TextBlock Text="Loại món" Foreground="#64748B" FontSize="9" FontWeight="SemiBold" Margin="0 0 0 4"/>
                                <ComboBox x:Name="cboDashboardTypeFilter" SelectedIndex="0" SelectionChanged="DashboardFilter_Changed">
                                    <ComboBoxItem Content="Tất cả loại" Tag="All"/>
                                    <ComboBoxItem Content="Món lẻ" Tag="Single"/>
                                    <ComboBoxItem Content="Combo" Tag="Combo"/>
                                    <ComboBoxItem Content="Món thêm" Tag="AddonOnly"/>
                                    <ComboBoxItem Content="Đồ uống" Tag="Drink"/>
                                    <ComboBoxItem Content="Món phụ" Tag="SideDish"/>
                                </ComboBox>
                            </StackPanel>
                            <StackPanel Grid.Column="3" Margin="0 0 8 0">
                                <TextBlock Text="Trạng thái" Foreground="#64748B" FontSize="9" FontWeight="SemiBold" Margin="0 0 0 4"/>
                                <ComboBox x:Name="cboDashboardStatusFilter" SelectedIndex="0" SelectionChanged="DashboardFilter_Changed">
                                    <ComboBoxItem Content="Tất cả trạng thái"/>
                                    <ComboBoxItem Content="Đang bán"/>
                                    <ComboBoxItem Content="Sắp hết"/>
                                    <ComboBoxItem Content="Hết hàng"/>
                                    <ComboBoxItem Content="Tạm ngưng"/>
                                </ComboBox>
                            </StackPanel>
                            <Button Grid.Column="4" Content="Xóa lọc" Click="btnClearDashboardFilters_Click" Height="40" Padding="14 5" VerticalAlignment="Bottom"/>
                        </Grid>
                    </Border>

                    <Border Grid.Row="2" Style="{StaticResource CardStyle}" Padding="10">
                        <Grid>
                            <ListBox x:Name="lstDashboardMenuItems" Background="Transparent" BorderThickness="0"
                                     SelectionChanged="lstDashboardMenuItems_SelectionChanged"
                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                <ListBox.ItemsPanel>
                                    <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                                </ListBox.ItemsPanel>
                                <ListBox.ItemContainerStyle>
                                    <Style TargetType="ListBoxItem">
                                        <Setter Property="Margin" Value="5"/>
                                        <Setter Property="Padding" Value="0"/>
                                        <Setter Property="Background" Value="Transparent"/>
                                        <Setter Property="BorderBrush" Value="Transparent"/>
                                        <Setter Property="BorderThickness" Value="1"/>
                                        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="ListBoxItem">
                                                    <Border x:Name="SelectionBorder" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="10">
                                                        <ContentPresenter/>
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="SelectionBorder" Property="BorderBrush" Value="#76503A"/></Trigger>
                                                        <Trigger Property="IsSelected" Value="True"><Setter TargetName="SelectionBorder" Property="BorderBrush" Value="#0866E5"/></Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </ListBox.ItemContainerStyle>
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Border Width="210" Height="244" Background="#FFFFFF" CornerRadius="16" BorderBrush="#E2E8F0" BorderThickness="1">
                                            <Grid>
                                                <Grid.RowDefinitions><RowDefinition Height="132"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                                                <Border Background="#F8FAFC" CornerRadius="16 16 0 0" ClipToBounds="True">
                                                    <Grid>
                                                        <Image Source="{Binding ImageUrl}" Stretch="UniformToFill"/>
                                                        <TextBlock Text="&#xEB9F;" FontFamily="Segoe Fluent Icons" Foreground="#59636F" FontSize="28" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                            <TextBlock.Style>
                                                                <Style TargetType="TextBlock">
                                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding ImageUrl}" Value="{x:Null}"><Setter Property="Visibility" Value="Visible"/></DataTrigger>
                                                                        <DataTrigger Binding="{Binding ImageUrl}" Value=""><Setter Property="Visibility" Value="Visible"/></DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </TextBlock.Style>
                                                        </TextBlock>
                                                    </Grid>
                                                </Border>
                                                <Grid Grid.Row="1" Margin="13 11 13 12">
                                                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                                                    <TextBlock Text="{Binding ItemName}" Foreground="#0F172A" FontSize="14" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                                    <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0 4 0 0">
                                                        <TextBlock Text="{Binding ItemCode}" Foreground="#0866E5" FontSize="11" FontWeight="SemiBold"/>
                                                        <TextBlock Text="  ·  " Foreground="#59636F" FontSize="11"/>
                                                        <TextBlock Text="{Binding CategoryName}" Foreground="#89929D" FontSize="11" TextTrimming="CharacterEllipsis"/>
                                                    </StackPanel>
                                                    <Grid Grid.Row="3"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                                        <TextBlock Text="{Binding PriceText, StringFormat={}{0} ₫}" Foreground="#0B55A0" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                                        <ContentControl Grid.Column="1" Content="{Binding StatusBadge}" ContentTemplate="{StaticResource BadgeTemplate}"/>
                                                    </Grid>
                                                </Grid>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                            <StackPanel x:Name="pnlDashboardEmpty" Visibility="Collapsed" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <TextBlock Text="&#xEB9F;" FontFamily="Segoe Fluent Icons" Foreground="#59636F" FontSize="34" HorizontalAlignment="Center"/>
                                <TextBlock Text="Chưa tìm thấy món ăn" Foreground="#B8C0C9" FontSize="14" FontWeight="SemiBold" Margin="0 10 0 0"/>
                                <TextBlock Text="Thử đổi từ khóa hoặc xóa bớt điều kiện lọc." Foreground="#7F8995" FontSize="11" Margin="0 5 0 0"/>
                            </StackPanel>
                        </Grid>
                    </Border>
                </Grid>

                <Grid x:Name="pnlCategories" Visibility="Collapsed">
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                    <Grid Margin="0 0 0 10">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <TextBox x:Name="txtCategorySearch" TextChanged="txtCategorySearch_TextChanged" Margin="0 0 8 0"/>
                        <Button x:Name="btnNewCategory" Grid.Column="1" Content="+ Danh mục" Style="{StaticResource PrimaryButtonStyle}" Click="btnNewCategory_Click" Margin="8 0 0 0"/>
                    </Grid>
                    <Border Grid.Row="1" Style="{StaticResource CardStyle}" Padding="0">
                        <DataGrid x:Name="dgCategories" SelectionChanged="dgCategories_SelectionChanged">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="DANH MỤC" Binding="{Binding CategoryName}" Width="*"/>
                                <DataGridTextColumn Header="THỨ TỰ" Binding="{Binding DisplayOrder}" Width="90"/>
                                <DataGridTextColumn Header="SỐ MÓN" Binding="{Binding ItemCount}" Width="90"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Border>
                </Grid>

                <Grid x:Name="pnlMenuItems" Visibility="Collapsed">
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                    <Border Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="16" Padding="14 12">
                        <Grid>
                            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>

                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <StackPanel Margin="0 0 12 0">
                                    <TextBlock Text="Tìm kiếm" Style="{StaticResource FieldLabelStyle}" Margin="0 0 0 6"/>
