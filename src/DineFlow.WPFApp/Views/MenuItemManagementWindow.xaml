                    </Grid>
                    <Border Grid.Row="2" Style="{StaticResource CardStyle}" Padding="0">
                        <Grid>
                        <DataGrid x:Name="dgMenuItems" SelectionChanged="dgMenuItems_SelectionChanged">
                            <DataGrid.Columns>
                                <DataGridTemplateColumn Header="ẢNH" Width="68">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Border Width="44" Height="38" CornerRadius="8" Background="#F8FAFC" ClipToBounds="True">
                                                <Grid>
                                                    <Image Source="{Binding ImageUrl}" Stretch="UniformToFill"/>
                                                    <TextBlock Text="&#xEB9F;" FontFamily="Segoe Fluent Icons" Foreground="#59636F" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                        <TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding ImageUrl}" Value="{x:Null}"><Setter Property="Visibility" Value="Visible"/></DataTrigger><DataTrigger Binding="{Binding ImageUrl}" Value=""><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style>
                                                    </TextBlock>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTextColumn Header="MÃ MÓN" Binding="{Binding ItemCode}" Width="78"/>
                                <DataGridTextColumn Header="TÊN MÓN" Binding="{Binding ItemName}" Width="1.7*"/>
                                <DataGridTextColumn Header="DANH MỤC" Binding="{Binding CategoryName}" Width="*"/>
                                <DataGridTextColumn Header="GIÁ" Binding="{Binding PriceText}" Width="90"/>
                                <DataGridTextColumn Header="TỒN KHO" Binding="{Binding StockText}" Width="85"/>
                                <DataGridTemplateColumn Header="TRẠNG THÁI" Width="120"><DataGridTemplateColumn.CellTemplate><DataTemplate><ContentControl Content="{Binding StatusBadge}" ContentTemplate="{StaticResource BadgeTemplate}"/></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                        <StackPanel x:Name="pnlMenuItemsEmpty" Visibility="Collapsed" HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False">
                            <Border Width="48" Height="48" CornerRadius="12" Background="#F0F7FF" HorizontalAlignment="Center">
                                <TextBlock Text="&#xE721;" FontFamily="Segoe Fluent Icons" Foreground="#0866E5" FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <TextBlock Text="Không tìm thấy món phù hợp" Foreground="#1E293B" FontSize="14" FontWeight="SemiBold" Margin="0 12 0 0" HorizontalAlignment="Center"/>
                            <TextBlock Text="Thử đổi từ khóa hoặc xóa bớt điều kiện lọc." Foreground="#7F8995" FontSize="11" Margin="0 5 0 0" HorizontalAlignment="Center"/>
                        </StackPanel>
                        </Grid>
                    </Border>
                </Grid>

                <Grid x:Name="pnlAddons" Visibility="Collapsed">
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="330"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>

                        <Border Grid.Column="0" Style="{StaticResource CardStyle}" Padding="18" Margin="0 0 12 0">
                            <Grid>
                                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="Thư viện lựa chọn" Style="{StaticResource SectionTitleStyle}" FontSize="17"/>
                                        <TextBlock Text="Dùng lại cho nhiều món" Foreground="#64748B" FontSize="10" Margin="0 3 0 0"/>
                                    </StackPanel>
                                    <Button Grid.Column="1" Content="+ Nhóm" Style="{StaticResource PrimaryButtonStyle}"
                                            Height="34" Padding="12 3" Click="btnCreateGlobalGroup_Click"/>
                                </Grid>
                                <Grid Grid.Row="1" Margin="0 14 0 0">
                                    <TextBox x:Name="txtGlobalGroupSearch" TextChanged="txtGlobalGroupSearch_TextChanged"
                                             Padding="34 6 10 6" ToolTip="Tìm theo tên nhóm hoặc quy tắc chọn"/>
                                    <TextBlock Text="&#xE721;" FontFamily="Segoe Fluent Icons" Foreground="#94A3B8"
                                               Margin="11 0 0 0" HorizontalAlignment="Left" VerticalAlignment="Center" IsHitTestVisible="False"/>
                                </Grid>
                                <Border Grid.Row="2" Background="#F0F7FF" BorderBrush="#D1E9FF" BorderThickness="1"
                                        CornerRadius="10" Padding="10" Margin="0 10 0 10">
                                    <TextBlock Text="Chọn một nhóm để xem lựa chọn, món đang sử dụng và chỉnh quy tắc áp dụng."
                                               Foreground="#0B55A0" FontSize="10" TextWrapping="Wrap" LineHeight="15"/>
                                </Border>
                                <ListBox x:Name="lstGlobalChoiceGroups" Grid.Row="3" Background="Transparent" BorderThickness="0"
                                         SelectionChanged="lstGlobalChoiceGroups_SelectionChanged"
                                         ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                    <ListBox.ItemContainerStyle>
                                        <Style TargetType="ListBoxItem">
                                            <Setter Property="Padding" Value="0"/>
                                            <Setter Property="Margin" Value="0 0 0 7"/>
                                            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                            <Setter Property="Background" Value="Transparent"/>
                                            <Setter Property="BorderThickness" Value="0"/>
                                        </Style>
                                    </ListBox.ItemContainerStyle>
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <Border x:Name="GroupCard" BorderThickness="1" CornerRadius="10" Padding="12">
                                                <Grid>
                                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                                    <StackPanel>
                                                        <TextBlock Text="{Binding GroupName}" Foreground="#1E293B" FontWeight="SemiBold" FontSize="13"/>
                                                        <TextBlock Text="{Binding RuleText}" Foreground="#64748B" FontSize="10" Margin="0 3 0 0"/>
                                                        <TextBlock Text="{Binding AppliedItemCount, StringFormat={}{0} món đang áp dụng}" Foreground="#0866E5" FontSize="9" Margin="0 5 0 0"/>
                                                    </StackPanel>
                                                    <Border Grid.Column="1" Background="#F0FDF4" BorderBrush="#DCFCE7" BorderThickness="1" CornerRadius="8" Padding="7 4" VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding OptionCount, StringFormat={}{0} option}" Foreground="#16A34A" FontSize="10" FontWeight="SemiBold"/>
                                                    </Border>
                                                </Grid>
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Setter Property="Background" Value="#FFFFFF"/>
                                                        <Setter Property="BorderBrush" Value="#E2E8F0"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                                                                <Setter Property="Background" Value="#F0F7FF"/>
                                                                <Setter Property="BorderBrush" Value="#0866E5"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                            </Border>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </Grid>
                        </Border>

                        <Border Grid.Column="1" Style="{StaticResource CardStyle}" Padding="0" Margin="12 0 0 0" ClipToBounds="True">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="1.35*"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="1*"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <Border Background="#F8FAFC" Padding="18 14">
                                    <Grid>
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock x:Name="txtGlobalGroupName" Text="Chọn nhóm lựa chọn" Foreground="#0F172A" FontSize="20" FontWeight="Bold"/>
                                            <TextBlock x:Name="txtGlobalGroupRule" Text="Các option của nhóm sẽ hiển thị tại đây."
                                                       Foreground="#64748B" FontSize="11" Margin="0 4 0 0"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                                            <Button x:Name="btnDeleteGlobalGroup" Content="Xóa nhóm" Height="36" Padding="12 3"
                                                    Style="{StaticResource DangerButtonStyle}" Click="btnDeleteGlobalGroup_Click" IsEnabled="False" Margin="0 0 8 0"/>
                                            <Button x:Name="btnEditGlobalGroup" Content="Sửa quy tắc" Height="36" Padding="12 3"
                                                    Click="btnEditGlobalGroup_Click" IsEnabled="False" Margin="0 0 8 0"/>
                                            <Button x:Name="btnCreateGlobalChoice" Content="+ Lựa chọn" Height="36" Padding="12 3"
                                                    Style="{StaticResource PrimaryButtonStyle}" Click="btnCreateGlobalChoice_Click" IsEnabled="False"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                                <Grid Grid.Row="1" Margin="18 13 18 8">
                                    <TextBlock Text="Các lựa chọn trong nhóm" Foreground="#0F172A" FontSize="13" FontWeight="SemiBold"/>
                                    <TextBlock Text="Chọn một dòng để chỉnh sửa" Foreground="#64748B" FontSize="9" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                </Grid>
                                <DataGrid x:Name="dgGlobalChoiceItems" Grid.Row="2" Margin="18 0 18 12" SelectionChanged="dgGlobalChoiceItems_SelectionChanged"
                                          IsReadOnly="True" CanUserAddRows="False" HeadersVisibility="Column" RowHeaderWidth="0" RowHeight="52">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="#" Binding="{Binding DisplayOrder}" Width="48"/>
                                        <DataGridTextColumn Header="LỰA CHỌN" Binding="{Binding ChoiceName}" Width="*"/>
                                        <DataGridTextColumn Header="GIÁ CỘNG" Binding="{Binding ExtraPrice, StringFormat={}{0:N0} ₫}" Width="120"/>
                                        <DataGridTextColumn Header="MÓN LIÊN KẾT" Binding="{Binding LinkedItemName}" Width="150"/>
                                        <DataGridTextColumn Header="ÁP DỤNG" Binding="{Binding AppliedItemCount, StringFormat={}{0} món}" Width="85"/>
                                        <DataGridTextColumn Header="TRẠNG THÁI" Binding="{Binding StatusText}" Width="100"/>
                                    </DataGrid.Columns>
                                </DataGrid>

                                <Border Grid.Row="3" Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="0 1 0 1" Padding="18 11">
                                    <Grid>
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="Món đang sử dụng nhóm này" Foreground="#0F172A" FontSize="13" FontWeight="SemiBold"/>
                                            <TextBlock Text="Sửa quy tắc áp dụng hoặc gỡ nhóm khỏi từng món." Foreground="#64748B" FontSize="9" Margin="0 3 0 0"/>
                                        </StackPanel>
                                        <Border Grid.Column="1" Background="#EAF3FF" CornerRadius="8" Padding="9 5" VerticalAlignment="Center">
                                            <TextBlock x:Name="txtGlobalUsageCount" Text="0 món" Foreground="#0866E5" FontSize="10" FontWeight="SemiBold"/>
                                        </Border>
                                    </Grid>
                                </Border>

                                <Grid Grid.Row="4">
                                    <DataGrid x:Name="dgGlobalAppliedItems" Margin="18 8 18 10" RowHeight="50" HeadersVisibility="Column" RowHeaderWidth="0">
                                        <DataGrid.Columns>
                                            <DataGridTemplateColumn Header="MÓN ĂN" Width="*">
                                                <DataGridTemplateColumn.CellTemplate><DataTemplate><StackPanel><TextBlock Text="{Binding ItemName}" Foreground="#0F172A" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/><TextBlock Text="{Binding ItemMeta}" Foreground="#94A3B8" FontSize="9" Margin="0 2 0 0"/></StackPanel></DataTemplate></DataGridTemplateColumn.CellTemplate>
                                            </DataGridTemplateColumn>
                                            <DataGridTextColumn Header="QUY TẮC" Binding="{Binding RuleText}" Width="155"/>
                                            <DataGridTemplateColumn Header="THAO TÁC" Width="145">
                                                <DataGridTemplateColumn.CellTemplate>
                                                    <DataTemplate>
                                                        <StackPanel Orientation="Horizontal">
                                                            <Button Content="Sửa" Height="30" Padding="10 2" Tag="{Binding}" IsEnabled="{Binding CanManage}" Click="EditGlobalMapping_Click" Margin="0 0 5 0"/>
                                                            <Button Content="Gỡ" Height="30" Padding="10 2" Tag="{Binding}" IsEnabled="{Binding CanManage}" Click="RemoveGlobalMapping_Click" Style="{StaticResource DangerButtonStyle}"/>
                                                        </StackPanel>
                                                    </DataTemplate>
                                                </DataGridTemplateColumn.CellTemplate>
                                            </DataGridTemplateColumn>
                                        </DataGrid.Columns>
                                    </DataGrid>
                                    <StackPanel x:Name="pnlGlobalAppliedEmpty" HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False">
                                        <TextBlock Text="Nhóm này chưa được gắn vào món nào" Foreground="#64748B" FontSize="11" FontStyle="Italic"/>
                                    </StackPanel>
                                </Grid>

                                <Border x:Name="pnlGlobalMappingEditor" Grid.Row="5" Visibility="Collapsed" Background="#F0F7FF" BorderBrush="#D1E9FF" BorderThickness="0 1 0 0" Padding="18 12">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/><ColumnDefinition Width="90"/><ColumnDefinition Width="90"/><ColumnDefinition Width="90"/><ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Margin="0 0 12 0">
                                            <TextBlock x:Name="txtGlobalMappingItemName" Text="Chỉnh quy tắc cho món" Foreground="#0F172A" FontWeight="SemiBold"/>
                                            <CheckBox x:Name="chkGlobalMappingRequired" Content="Bắt buộc chọn" Margin="0 5 0 0"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Margin="0 0 8 0"><TextBlock Text="Tối thiểu" Foreground="#64748B" FontSize="9" Margin="0 0 0 4"/><TextBox x:Name="txtGlobalMappingMin" Height="34"/></StackPanel>
                                        <StackPanel Grid.Column="2" Margin="0 0 8 0"><TextBlock Text="Tối đa" Foreground="#64748B" FontSize="9" Margin="0 0 0 4"/><TextBox x:Name="txtGlobalMappingMax" Height="34"/></StackPanel>
                                        <StackPanel Grid.Column="3" Margin="0 0 12 0"><TextBlock Text="Thứ tự" Foreground="#64748B" FontSize="9" Margin="0 0 0 4"/><TextBox x:Name="txtGlobalMappingOrder" Height="34"/></StackPanel>
                                        <StackPanel Grid.Column="4" Orientation="Horizontal" VerticalAlignment="Bottom">
                                            <Button Content="Hủy" Height="34" Click="CancelGlobalMappingEdit_Click" Margin="0 0 6 0"/>
                                            <Button Content="Lưu" Height="34" Style="{StaticResource PrimaryButtonStyle}" Click="SaveGlobalMapping_Click"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </Grid>
                        </Border>
                    </Grid>

                    <Grid Visibility="Collapsed">
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                    <Border Background="#F0F7FF" BorderBrush="#D1E9FF" BorderThickness="1" CornerRadius="16" Padding="16" Margin="0 0 0 12">
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="Bắt đầu bằng món cần cấu hình" Foreground="#0F172A" FontWeight="SemiBold" FontSize="14"/>
                                <TextBlock Text="Chọn món, gắn nhóm rồi thêm các option. Thay đổi được lưu theo từng bước."
                                           Foreground="#475569" FontSize="11" Margin="0 4 0 10"/>
                                <ComboBox x:Name="cboAddonParentMenuItem" Width="420" HorizontalAlignment="Left" SelectedValuePath="MenuItemId" SelectionChanged="cboAddonParentMenuItem_SelectionChanged">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="{Binding ItemName}" Foreground="#1E293B" FontWeight="SemiBold"/>
                                                <TextBlock Text="  ·  " Foreground="#94A3B8"/>
                                                <TextBlock Text="{Binding Category.CategoryName}" Foreground="#64748B"/>
                                            </StackPanel>
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="24 0 0 0">
                                <Border Background="#0866E5" CornerRadius="8" Padding="10 7"><TextBlock Text="1  Chọn món" Foreground="White" FontWeight="SemiBold"/></Border>
                                <TextBlock Text="  →  " Foreground="#64748B" VerticalAlignment="Center"/>
                                <Border Background="#FFFFFF" BorderBrush="#D1E9FF" BorderThickness="1" CornerRadius="8" Padding="10 7"><TextBlock Text="2  Gắn nhóm" Foreground="#0B55A0" FontWeight="SemiBold"/></Border>
                                <TextBlock Text="  →  " Foreground="#64748B" VerticalAlignment="Center"/>
                                <Border Background="#FFFFFF" BorderBrush="#D1E9FF" BorderThickness="1" CornerRadius="8" Padding="10 7"><TextBlock Text="3  Thêm lựa chọn" Foreground="#0B55A0" FontWeight="SemiBold"/></Border>
                            </StackPanel>
                        </Grid>
                    </Border>
                    <Grid Grid.Row="1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="2*"/>
                            <ColumnDefinition Width="3*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Left Column: Choice Group Library -->
                        <Border Grid.Column="0" Style="{StaticResource CardStyle}" Padding="16" Margin="0 0 10 0">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>

                                <Grid Grid.Row="0" Margin="0 0 0 4">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <TextBlock Text="1. Chọn nhóm cho món" Style="{StaticResource SectionTitleStyle}" VerticalAlignment="Center"/>
                                    <Button Grid.Column="1" Content="+ Tạo nhóm" Height="32" Padding="10 3" Style="{StaticResource PrimaryButtonStyle}" Click="btnNewAddonGroupEditor_Click"/>
                                </Grid>
                                <TextBlock Grid.Row="1" Text="Đánh dấu nhóm cần dùng. Một nhóm có thể tái sử dụng cho nhiều món." 
                                           Foreground="#7F8995" FontSize="11" Margin="0 0 0 12" TextWrapping="Wrap"/>

                                <ListBox x:Name="lstChoiceGroupLibrary" Grid.Row="2" Background="Transparent" BorderThickness="0" 
                                         ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Auto">
                                    <ListBox.ItemContainerStyle>
                                        <Style TargetType="ListBoxItem">
                                            <Setter Property="Background" Value="Transparent"/>
                                            <Setter Property="BorderThickness" Value="0"/>
                                            <Setter Property="Padding" Value="0"/>
                                            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                            <Style.Triggers>
                                                <Trigger Property="IsSelected" Value="True">
                                                    <Setter Property="Background" Value="#F0F7FF"/>
                                                </Trigger>
                                            </Style.Triggers>
                                        </Style>
                                    </ListBox.ItemContainerStyle>
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <Border BorderBrush="#E2E8F0" BorderThickness="0 0 0 1" Padding="4 10" Background="Transparent">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="30"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <CheckBox IsChecked="{Binding IsAssigned, Mode=OneTime}" IsEnabled="{Binding CanManage}" Tag="{Binding}" Click="ChoiceGroupAssignment_Click" VerticalAlignment="Center"/>
                                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding GroupName}" Foreground="#1E293B" FontWeight="SemiBold" FontSize="13"/>
                                                        <TextBlock Text="{Binding RuleText}" Foreground="#7F8995" FontSize="10" Margin="0 3 0 0"/>
                                                    </StackPanel>
                                                    <Border Grid.Column="2" CornerRadius="8" Padding="7 4" Background="#F0FDF4" BorderBrush="#DCFCE7" BorderThickness="1" VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding OptionCount, StringFormat={}{0} lựa chọn}" Foreground="#16A34A" FontSize="10" FontWeight="SemiBold"/>
                                                    </Border>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </Grid>
                        </Border>

                        <!-- Right Column: Applied Groups and Options -->
                        <Border Grid.Column="1" Style="{StaticResource CardStyle}" Padding="16" Margin="10 0 0 0">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="1*"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="1.2*"/>
                                </Grid.RowDefinitions>

                                <!-- Part 1: Assigned groups for this parent item -->
                                <Grid Grid.Row="0" Margin="0 0 0 10">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <TextBlock Text="2. Nhóm đã gắn với món" Style="{StaticResource SectionTitleStyle}" VerticalAlignment="Center"/>
                                    <Button Grid.Column="1" Content="Sửa nhóm" Height="32" Padding="10 3" Click="btnEditAddonGroupEditor_Click"/>
                                </Grid>
                                <DataGrid x:Name="dgAddonGroups" Grid.Row="1" SelectionChanged="dgAddonGroups_SelectionChanged" 
                                          AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True" 
                                          HeadersVisibility="Column" RowHeaderWidth="0">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="NHÓM LỰA CHỌN" Binding="{Binding MenuAddonGroup.GroupName}" Width="*"/>
                                        <DataGridCheckBoxColumn Header="BẮT BUỘC" Binding="{Binding IsRequired}" Width="90" IsReadOnly="True"/>
                                        <DataGridTextColumn Header="MIN" Binding="{Binding MinSelect}" Width="60"/>
                                        <DataGridTextColumn Header="MAX" Binding="{Binding MaxSelect}" Width="60"/>
                                    </DataGrid.Columns>
                                </DataGrid>

                                <!-- Part 2: Choice items in the selected group -->
                                <Grid Grid.Row="2" Margin="0 16 0 10">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <TextBlock Text="3. Các lựa chọn khách sẽ thấy" Style="{StaticResource SectionTitleStyle}" VerticalAlignment="Center"/>
                                    <Button Grid.Column="1" Content="+ Thêm lựa chọn" Height="32" Padding="10 3"
                                            Style="{StaticResource PrimaryButtonStyle}" Click="btnNewChoice_Click"/>
                                </Grid>
