                            <Grid Grid.Row="1" Margin="0 12 0 0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" MinWidth="180"/>
                                    <ColumnDefinition Width="155"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Margin="0 0 10 0">
                                    <TextBlock Text="Danh mục" Style="{StaticResource FieldLabelStyle}" Margin="0 0 0 6"/>
                                    <ComboBox x:Name="cboItemCategoryFilter" SelectionChanged="cboItemFilter_SelectionChanged"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1" Margin="0 0 10 0">
                                    <TextBlock Text="Trạng thái" Style="{StaticResource FieldLabelStyle}" Margin="0 0 0 6"/>
                                    <ComboBox x:Name="cboItemStatusFilter" SelectedIndex="3" SelectionChanged="cboItemFilter_SelectionChanged">
                                        <ComboBoxItem Content="Đang bán"/><ComboBoxItem Content="Tạm ngưng"/><ComboBoxItem Content="Sắp hết"/><ComboBoxItem Content="Tất cả"/>
                                    </ComboBox>
                                </StackPanel>
                                <Button Grid.Column="2" Content="Xóa lọc" Click="btnClearItemFilters_Click"
                                        Height="40" MinWidth="88" Margin="0 20 0 0" Padding="12 5" ToolTip="Đưa bộ lọc về mặc định"/>
                            </Grid>
                        </Grid>
                    </Border>
                    <Grid Grid.Row="1" Margin="2 9">
                        <TextBlock x:Name="txtItemListSummary" Foreground="#929AA5" FontSize="11"/>
