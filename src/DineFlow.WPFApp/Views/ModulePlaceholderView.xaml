<UserControl x:Class="DineFlow.WPFApp.Views.ModulePlaceholderView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#0B0E12"
             FontFamily="Segoe UI Variable Text"
             TextOptions.TextFormattingMode="Display"
             UseLayoutRounding="True">
    <UserControl.Resources>
        <SolidColorBrush x:Key="SurfaceBrush" Color="#151A20"/>
        <SolidColorBrush x:Key="SurfaceStrongBrush" Color="#1A2027"/>
        <SolidColorBrush x:Key="BorderBrush" Color="#2A313A"/>
        <SolidColorBrush x:Key="TextBrush" Color="#F2F4F6"/>
        <SolidColorBrush x:Key="MutedBrush" Color="#8E97A3"/>
        <SolidColorBrush x:Key="AccentBrush" Color="#D9824B"/>

        <Style x:Key="MetricCardStyle" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource SurfaceStrongBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Padding" Value="18"/>
        </Style>

        <Style x:Key="MutedLineStyle" TargetType="Border">
            <Setter Property="Height" Value="8"/>
            <Setter Property="CornerRadius" Value="4"/>
            <Setter Property="Background" Value="#252C34"/>
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <Grid Margin="28 24 28 30">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock x:Name="txtBreadcrumb" Foreground="#707A86" FontSize="10" FontWeight="SemiBold"/>
                    <StackPanel Orientation="Horizontal" Margin="0 8 0 0">
                        <TextBlock x:Name="txtIcon" FontFamily="Segoe Fluent Icons" Foreground="{StaticResource AccentBrush}"
                                   FontSize="22" Margin="0 0 11 0" VerticalAlignment="Center"/>
                        <TextBlock x:Name="txtTitle" Foreground="{StaticResource TextBrush}" FontSize="26" FontWeight="Bold"/>
                    </StackPanel>
                    <TextBlock x:Name="txtSubtitle" Foreground="{StaticResource MutedBrush}" FontSize="13"
                               TextWrapping="Wrap" MaxWidth="680" Margin="0 7 0 0"/>
                </StackPanel>
                <Border Grid.Column="1" Background="#2B211C" BorderBrush="#5A3B2B" BorderThickness="1"
                        CornerRadius="7" Padding="11 7" VerticalAlignment="Top">
                    <StackPanel Orientation="Horizontal">
                        <Ellipse Width="6" Height="6" Fill="#D9824B" Margin="0 0 7 0" VerticalAlignment="Center"/>
                        <TextBlock Text="Giao diện mẫu" Foreground="#E8A77E" FontSize="11" FontWeight="SemiBold"/>
                    </StackPanel>
                </Border>
            </Grid>

            <Grid Grid.Row="1" Margin="0 24 0 18">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Border Style="{StaticResource MetricCardStyle}" Margin="0 0 7 0">
                    <StackPanel><TextBlock x:Name="txtMetricOneLabel" Foreground="{StaticResource MutedBrush}" FontSize="12"/><TextBlock Text="—" Foreground="{StaticResource TextBrush}" FontSize="24" FontWeight="Bold" Margin="0 8 0 0"/></StackPanel>
                </Border>
                <Border Grid.Column="1" Style="{StaticResource MetricCardStyle}" Margin="7 0">
                    <StackPanel><TextBlock x:Name="txtMetricTwoLabel" Foreground="{StaticResource MutedBrush}" FontSize="12"/><TextBlock Text="—" Foreground="{StaticResource TextBrush}" FontSize="24" FontWeight="Bold" Margin="0 8 0 0"/></StackPanel>
                </Border>
                <Border Grid.Column="2" Style="{StaticResource MetricCardStyle}" Margin="7 0 0 0">
                    <StackPanel><TextBlock x:Name="txtMetricThreeLabel" Foreground="{StaticResource MutedBrush}" FontSize="12"/><TextBlock Text="—" Foreground="{StaticResource TextBrush}" FontSize="24" FontWeight="Bold" Margin="0 8 0 0"/></StackPanel>
                </Border>
            </Grid>

            <Grid Grid.Row="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.7*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Border Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}"
                        BorderThickness="1" CornerRadius="11" Margin="0 0 9 0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <Grid Margin="18 16 18 14">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="180"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock x:Name="txtSectionTitle" Foreground="{StaticResource TextBrush}" FontSize="15" FontWeight="SemiBold"/>
                                <TextBlock Text="Dữ liệu sẽ xuất hiện tại đây khi module được kết nối." Foreground="{StaticResource MutedBrush}" FontSize="11" Margin="0 4 0 0"/>
                            </StackPanel>
                            <Border Grid.Column="1" Height="38" Background="#101419" BorderBrush="#343B44" BorderThickness="1" CornerRadius="6" Margin="0 0 9 0">
                                <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="32"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                    <TextBlock Text="&#xE721;" FontFamily="Segoe Fluent Icons" Foreground="#727C88" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="1" Text="Tìm kiếm..." Foreground="#727C88" FontSize="12" VerticalAlignment="Center"/>
                                </Grid>
                            </Border>
                            <Border Grid.Column="2" Height="38" Background="#20262D" BorderBrush="#343C46" BorderThickness="1" CornerRadius="6" Padding="12 0">
                                <TextBlock x:Name="txtAction" Foreground="#8F98A3" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center"/>
                            </Border>
                        </Grid>

                        <Grid Grid.Row="1" Height="40" Background="#181E24">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="2*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <TextBlock x:Name="txtColumnOne" Foreground="#89939F" FontSize="11" FontWeight="SemiBold" Margin="18 0" VerticalAlignment="Center"/>
                            <TextBlock x:Name="txtColumnTwo" Grid.Column="1" Foreground="#89939F" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center"/>
                            <TextBlock x:Name="txtColumnThree" Grid.Column="2" Foreground="#89939F" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        </Grid>

                        <StackPanel Grid.Row="2" Margin="18 12">
                            <Grid Height="50"><Grid.ColumnDefinitions><ColumnDefinition Width="2*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Border Width="180" Style="{StaticResource MutedLineStyle}" HorizontalAlignment="Left"/><Border Grid.Column="1" Width="76" Style="{StaticResource MutedLineStyle}" HorizontalAlignment="Left"/><Border Grid.Column="2" Width="64" Style="{StaticResource MutedLineStyle}" HorizontalAlignment="Left"/></Grid>
                            <Border Height="1" Background="#252C34"/>
                            <Grid Height="50"><Grid.ColumnDefinitions><ColumnDefinition Width="2*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Border Width="132" Style="{StaticResource MutedLineStyle}" HorizontalAlignment="Left"/><Border Grid.Column="1" Width="92" Style="{StaticResource MutedLineStyle}" HorizontalAlignment="Left"/><Border Grid.Column="2" Width="70" Style="{StaticResource MutedLineStyle}" HorizontalAlignment="Left"/></Grid>
                            <Border Height="1" Background="#252C34"/>
                            <Grid Height="50"><Grid.ColumnDefinitions><ColumnDefinition Width="2*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Border Width="156" Style="{StaticResource MutedLineStyle}" HorizontalAlignment="Left"/><Border Grid.Column="1" Width="68" Style="{StaticResource MutedLineStyle}" HorizontalAlignment="Left"/><Border Grid.Column="2" Width="82" Style="{StaticResource MutedLineStyle}" HorizontalAlignment="Left"/></Grid>
                        </StackPanel>
                    </Grid>
                </Border>

                <Border Grid.Column="1" Background="{StaticResource SurfaceStrongBrush}" BorderBrush="{StaticResource BorderBrush}"
                        BorderThickness="1" CornerRadius="11" Margin="9 0 0 0" Padding="20">
                    <StackPanel>
                        <Border Width="42" Height="42" CornerRadius="10" Background="#2B211C" HorizontalAlignment="Left">
                            <TextBlock Text="&#xE946;" FontFamily="Segoe Fluent Icons" Foreground="#D9824B" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock Text="Chưa kết nối nghiệp vụ" Foreground="{StaticResource TextBrush}" FontSize="17" FontWeight="SemiBold" Margin="0 16 0 0"/>
                        <TextBlock x:Name="txtEmptyMessage" Foreground="{StaticResource MutedBrush}" FontSize="12" LineHeight="19" TextWrapping="Wrap" Margin="0 8 0 0"/>
                        <Border Height="1" Background="#2A313A" Margin="0 20 0 16"/>
                        <TextBlock Text="Phạm vi hiện tại" Foreground="#AAB2BC" FontSize="11" FontWeight="SemiBold"/>
                        <TextBlock Text="• Bố cục và điều hướng&#x0a;• Trạng thái rỗng&#x0a;• Khu vực tìm kiếm và bảng"
                                   Foreground="#7F8995" FontSize="12" LineHeight="22" Margin="0 8 0 0"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>
    </ScrollViewer>
</UserControl>
