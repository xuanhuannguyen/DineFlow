<Window x:Class="DineFlow.WPFApp.Views.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="DineFlow · Đăng nhập"
        Width="440" Height="560" ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        Background="#F4F7FB" FontFamily="Segoe UI Variable Text" UseLayoutRounding="True">
    <Window.Resources>
        <Style TargetType="TextBox">
            <Setter Property="Height" Value="42"/><Setter Property="Padding" Value="12 6"/>
            <Setter Property="Background" Value="#FFFFFF"/><Setter Property="Foreground" Value="#1E293B"/>
            <Setter Property="CaretBrush" Value="#0866E5"/><Setter Property="BorderBrush" Value="#CBD5E1"/>
            <Setter Property="BorderThickness" Value="1"/><Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <Style TargetType="PasswordBox">
            <Setter Property="Height" Value="42"/><Setter Property="Padding" Value="12 6"/>
            <Setter Property="Background" Value="#FFFFFF"/><Setter Property="Foreground" Value="#1E293B"/>
            <Setter Property="BorderBrush" Value="#CBD5E1"/><Setter Property="BorderThickness" Value="1"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
    </Window.Resources>

    <Border Margin="12" CornerRadius="16" Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="1" Padding="30">
        <Grid>
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <StackPanel>
                <StackPanel Orientation="Horizontal">
                    <Border Width="40" Height="40" CornerRadius="10" Background="#0866E5">
                        <TextBlock Text="🍴" FontSize="19" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel Margin="11 0 0 0" VerticalAlignment="Center">
                        <TextBlock Text="DineFlow" Foreground="#0F172A" FontWeight="Bold" FontSize="18"/>
                        <TextBlock Text="Quản lý nhà hàng" Foreground="#64748B" FontSize="10"/>
                    </StackPanel>
                </StackPanel>
                <TextBlock Text="Đăng nhập để vận hành menu" Foreground="#0F172A" FontSize="23" FontWeight="Bold" Margin="0 34 0 0"/>
                <TextBlock Text="Admin cấu hình toàn bộ menu. Staff cập nhật tồn kho và trạng thái bán."
                           Foreground="#64748B" FontSize="11" TextWrapping="Wrap" LineHeight="17" Margin="0 8 0 0"/>
            </StackPanel>

            <StackPanel Grid.Row="1" VerticalAlignment="Center">
                <TextBlock Text="Tên đăng nhập" Foreground="#475569" FontSize="11" FontWeight="SemiBold" Margin="0 0 0 6"/>
                <TextBox x:Name="txtUsername"/>
                <TextBlock Text="Mật khẩu" Foreground="#475569" FontSize="11" FontWeight="SemiBold" Margin="0 16 0 6"/>
                <PasswordBox x:Name="txtPassword"/>
                <Button Content="Đăng nhập" Height="44" Margin="0 22 0 0" Click="btnLogin_Click" IsDefault="True"
                        Background="#0B84F3" Foreground="White" BorderBrush="#0B84F3" BorderThickness="1"
                        FontWeight="SemiBold" Cursor="Hand"/>
                <Border Background="#F0F7FF" BorderBrush="#D1E9FF" BorderThickness="1" CornerRadius="10" Padding="11" Margin="0 14 0 0">
                    <StackPanel>
                        <TextBlock Text="Tài khoản demo" Foreground="#0B55A0" FontWeight="SemiBold" FontSize="10"/>
                        <TextBlock Text="admin / admin123     ·     staff / staff123" Foreground="#475569" FontSize="10" Margin="0 5 0 0"/>
                    </StackPanel>
                </Border>
            </StackPanel>
            <TextBlock Grid.Row="2" Text="PostgreSQL · localhost:5432 · DineFlowRuntimeUtf8" Foreground="#94A3B8" FontSize="9" HorizontalAlignment="Center"/>
        </Grid>
    </Border>
</Window>
