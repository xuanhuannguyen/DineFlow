<Window x:Class="DineFlow.WPFApp.Views.CreateChannelWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Tạo kênh bán mới"
        Height="390"
        Width="480"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="#F4F7FB"
        FontFamily="Segoe UI Variable Text"
        TextOptions.TextFormattingMode="Display"
        UseLayoutRounding="True">
    <Window.Resources>
        <Style TargetType="TextBox">
            <Setter Property="Height" Value="40"/>
            <Setter Property="Padding" Value="11 6"/>
            <Setter Property="Foreground" Value="#1E293B"/>
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="BorderBrush" Value="#CBD5E1"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CaretBrush" Value="#0866E5"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="SelectionBrush" Value="#BFDBFE"/>
        </Style>
        <Style TargetType="Button">
            <Setter Property="Height" Value="38"/>
            <Setter Property="Padding" Value="16 5"/>
            <Setter Property="Foreground" Value="#334155"/>
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="BorderBrush" Value="#CBD5E1"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style x:Key="PrimaryButtonStyle" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="#0B84F3"/>
            <Setter Property="BorderBrush" Value="#0B84F3"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
        </Style>
    </Window.Resources>

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Margin="0 0 0 20">
            <TextBlock Text="Tạo kênh bán mới" Foreground="#0F172A" FontSize="22" FontWeight="Bold"/>
            <TextBlock Text="Thêm kênh để cấu hình phần giá cộng thêm cho món và lựa chọn."
                       Foreground="#64748B" FontSize="11" Margin="0 5 0 0"/>
        </StackPanel>

        <Border Grid.Row="1" Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="12" Padding="16">
            <StackPanel>
                <TextBlock Text="Tên kênh bán" Foreground="#475569" FontSize="11" FontWeight="SemiBold" Margin="0 0 0 6"/>
                <TextBox x:Name="txtChannelName" ToolTip="Ví dụ: GrabFood, ShopeeFood"/>
                <TextBlock Text="Tên hiển thị cho nhân viên và khách hàng." Foreground="#94A3B8" FontSize="9" Margin="0 4 0 0"/>

                <TextBlock Text="Mã kênh" Foreground="#475569" FontSize="11" FontWeight="SemiBold" Margin="0 14 0 6"/>
                <TextBox x:Name="txtChannelCode" CharacterCasing="Upper" ToolTip="Ví dụ: GRAB_FOOD"/>
                <TextBlock Text="Dùng chữ in hoa và dấu gạch dưới, ví dụ GRAB_FOOD."
                           Foreground="#94A3B8" FontSize="9" Margin="0 4 0 0"/>
            </StackPanel>
        </Border>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0 16 0 0">
            <Button x:Name="btnCancel" Content="Hủy" Width="88" Click="btnCancel_Click" Margin="0 0 8 0"/>
            <Button x:Name="btnCreate" Content="Tạo kênh" Width="112" Click="btnCreate_Click" Style="{StaticResource PrimaryButtonStyle}"/>
        </StackPanel>
    </Grid>
</Window>
