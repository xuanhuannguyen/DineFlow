<UserControl x:Class="DineFlow.WPFApp.Features.Management.Tables.TableManagementControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" 
             Background="Transparent"
             d:DesignHeight="700" d:DesignWidth="1000">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Form Area -->
        <Border Grid.Row="0" Background="White" BorderBrush="{StaticResource BorderGray}" BorderThickness="1" CornerRadius="16" Padding="20" Margin="0,0,0,20">
            <Border.Effect>
                <DropShadowEffect Color="#E2E8F0" Direction="270" ShadowDepth="4" BlurRadius="10" Opacity="0.5"/>
            </Border.Effect>
            
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Text="Thông tin bàn ăn" Style="{StaticResource HeaderTextBlock}" Grid.Row="0"/>

                <!-- Row 1: Name, Area, Status -->
                <Grid Grid.Row="1" Margin="0,0,0,15">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="20"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="20"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Tên bàn" Style="{StaticResource LabelTextBlock}"/>
                        <TextBox x:Name="txtTableName" Style="{StaticResource ModernTextBox}" MaxLength="50" MinHeight="40"/>
                    </StackPanel>

                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Khu vực" Style="{StaticResource LabelTextBlock}"/>
                        <ComboBox x:Name="cboArea" Style="{StaticResource ModernComboBox}" DisplayMemberPath="AreaName" SelectedValuePath="AreaId" MinHeight="40"/>
                    </StackPanel>

                    <StackPanel Grid.Column="4">
                        <TextBlock Text="Trạng thái" Style="{StaticResource LabelTextBlock}"/>
                        <TextBox x:Name="txtStatus" Style="{StaticResource ModernTextBox}" IsReadOnly="True" MinHeight="40"/>
                    </StackPanel>
                </Grid>

                <!-- Row 2: QR Token, QR Url -->
                <Grid Grid.Row="2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="20"/>
                        <ColumnDefinition Width="2*"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Mã QR Token" Style="{StaticResource LabelTextBlock}"/>
                        <TextBox x:Name="txtQrToken" Style="{StaticResource ModernTextBox}" IsReadOnly="True" MinHeight="40"/>
                    </StackPanel>

                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Đường dẫn QR (URL)" Style="{StaticResource LabelTextBlock}"/>
                        <TextBox x:Name="txtQrUrl" Style="{StaticResource ModernTextBox}" IsReadOnly="True" MinHeight="40"/>
                    </StackPanel>
                </Grid>

                <!-- Row 3: Actions -->
                <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
                    <Button x:Name="btnClear" Content="Làm mới" Style="{StaticResource NeutralButton}" MinWidth="100" Click="BtnClear_Click"/>
                    <Button x:Name="btnUpdate" Content="Cập nhật" Style="{StaticResource PrimaryButton}" MinWidth="100" Margin="10,0,0,0" Click="BtnUpdate_Click"/>
                    <Button x:Name="btnCreate" Content="Thêm mới" Style="{StaticResource PrimaryButton}" MinWidth="100" Margin="10,0,0,0" Click="BtnCreate_Click"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- DataGrid Area -->
        <Border Grid.Row="1" Background="White" BorderBrush="{StaticResource BorderGray}" BorderThickness="1" CornerRadius="16" Padding="20">
            <Border.Effect>
                <DropShadowEffect Color="#E2E8F0" Direction="270" ShadowDepth="4" BlurRadius="10" Opacity="0.5"/>
            </Border.Effect>
            
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                
                <Grid Grid.Row="0" Margin="0,0,0,15">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    
                    <TextBlock Text="Danh sách bàn ăn" Style="{StaticResource HeaderTextBlock}" VerticalAlignment="Center" Margin="0" Grid.Column="0"/>
                    
                    <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right">
                        <TextBlock Text="Tìm kiếm" VerticalAlignment="Center" Margin="0,0,10,0" Foreground="{StaticResource Slate500}"/>
                        <TextBox x:Name="txtSearch" Style="{StaticResource ModernTextBox}" Width="180" MinHeight="36" Margin="0,0,15,0"/>
                        
                        <TextBlock Text="Lọc Khu vực" VerticalAlignment="Center" Margin="0,0,10,0" Foreground="{StaticResource Slate500}"/>
                        <ComboBox x:Name="cboFilterArea" Style="{StaticResource ModernComboBox}" Width="150" MinHeight="36" Margin="0,0,15,0"
                                  DisplayMemberPath="AreaName" SelectedValuePath="AreaId"/>
                                  
                        <Button x:Name="btnSearch" Content="Tìm kiếm" Style="{StaticResource PrimaryButton}" MinHeight="36" Padding="15,0" Click="BtnSearch_Click"/>
                        <Button x:Name="btnReload" Content="Tải lại" Style="{StaticResource OutlineButton}" MinHeight="36" Padding="15,0" Margin="10,0,0,0" Click="BtnReload_Click"/>
                        <Button x:Name="btnExportPdf" Content="Xuất PDF QR (Tất cả)" MinHeight="36" Padding="15,0" Margin="10,0,0,0" Click="BtnExportPdf_Click">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
                                    <Setter Property="Background" Value="{StaticResource GreenStatus}"/>
                                </Style>
                            </Button.Style>
                        </Button>
                    </StackPanel>
                </Grid>

                <DataGrid x:Name="dgTables" Grid.Row="1" AutoGenerateColumns="False" IsReadOnly="True" 
                          SelectionMode="Single" SelectionChanged="DgTables_SelectionChanged"
                          Background="Transparent" BorderThickness="0" RowBackground="White" AlternatingRowBackground="#FAFAFA"
                          HorizontalGridLinesBrush="{StaticResource BorderGray}" VerticalGridLinesBrush="Transparent"
                          HeadersVisibility="Column" RowHeight="50">
                    
                    <DataGrid.Resources>
                        <Style TargetType="DataGridColumnHeader">
                            <Setter Property="Background" Value="#F1F5F9"/>
                            <Setter Property="Foreground" Value="{StaticResource Slate700}"/>
                            <Setter Property="FontWeight" Value="Bold"/>
                            <Setter Property="Padding" Value="10,12"/>
                            <Setter Property="BorderThickness" Value="0,0,0,1"/>
                            <Setter Property="BorderBrush" Value="{StaticResource BorderGray}"/>
                        </Style>
                        <Style TargetType="DataGridCell">
                            <Setter Property="Padding" Value="10,0"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="DataGridCell">
                                        <Border Padding="{TemplateBinding Padding}" Background="{TemplateBinding Background}" BorderBrush="Transparent" BorderThickness="0">
                                            <ContentPresenter VerticalAlignment="Center"/>
                                        </Border>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                            <Style.Triggers>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter Property="Background" Value="{StaticResource LightBlueBackground}"/>
                                    <Setter Property="Foreground" Value="{StaticResource Slate900}"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </DataGrid.Resources>

                    <DataGrid.Columns>
                        <DataGridTextColumn Header="ID" Binding="{Binding TableId}" Width="60"/>
                        <DataGridTextColumn Header="TÊN BÀN" Binding="{Binding TableName}" Width="150">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                    <Setter Property="Foreground" Value="{StaticResource Slate900}"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        <DataGridTextColumn Header="KHU VỰC" Binding="{Binding AreaName}" Width="150"/>
                        
                        <DataGridTextColumn Header="TRẠNG THÁI" Binding="{Binding Status}" Width="120">
                            <!-- Ideally colored based on status, but default text is fine. If needed, we can template this. -->
                        </DataGridTextColumn>

                        <DataGridTemplateColumn Header="HOẠT ĐỘNG" Width="100">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Border Padding="8,4" CornerRadius="12" HorizontalAlignment="Left">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Background" Value="{StaticResource GreenLightStatus}"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsActive}" Value="False">
                                                        <Setter Property="Background" Value="#FEF2F2"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <TextBlock FontWeight="SemiBold">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Text" Value="Bật"/>
                                                    <Setter Property="Foreground" Value="{StaticResource GreenStatus}"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsActive}" Value="False">
                                                            <Setter Property="Text" Value="Tắt"/>
                                                            <Setter Property="Foreground" Value="{StaticResource RedStatus}"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </Border>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        
                        <DataGridTemplateColumn Header="HÀNH ĐỘNG" Width="380">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                                        <Button Click="BtnGridToggleActive_Click" MinWidth="90" Margin="0,0,8,0" Padding="10,4">
                                            <Button.Style>
                                                <Style TargetType="Button" BasedOn="{StaticResource OutlineButton}">
                                                    <Setter Property="Content" Value="Ngừng HĐ" />
                                                    <Setter Property="Foreground" Value="{StaticResource RedStatus}" />
                                                    <Setter Property="BorderBrush" Value="{StaticResource RedStatus}" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsActive}" Value="False">
                                                            <Setter Property="Content" Value="Bật HĐ" />
                                                            <Setter Property="Foreground" Value="{StaticResource GreenStatus}" />
                                                            <Setter Property="BorderBrush" Value="{StaticResource GreenStatus}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Button.Style>
                                        </Button>
                                        <Button Content="Xem QR" Style="{StaticResource OutlineButton}" MinWidth="80" Margin="0,0,8,0" Padding="10,4" Click="BtnGridViewQr_Click" />
                                        <Button Content="Tạo mã mới" Style="{StaticResource NeutralButton}" MinWidth="90" Margin="0,0,8,0" Padding="10,4" Click="BtnGridResetQr_Click" />
                                        <Button Content="Copy URL" Style="{StaticResource OutlineButton}" MinWidth="80" Padding="10,4" Click="BtnGridCopyUrl_Click" />
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </Border>
    </Grid>
</UserControl>
