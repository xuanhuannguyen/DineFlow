<UserControl x:Class="DineFlow.WPFApp.Features.Management.Tables.TableOverviewControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" 
             Background="#F8FAFC"
             d:DesignHeight="700" d:DesignWidth="1200">

    <UserControl.Resources>
        <Color x:Key="PrimaryBlueColor">#0866E5</Color>
        <SolidColorBrush x:Key="PrimaryBlue" Color="{StaticResource PrimaryBlueColor}"/>
        
        <Color x:Key="PrimaryDarkBlueColor">#0B55A0</Color>
        <SolidColorBrush x:Key="PrimaryDarkBlue" Color="{StaticResource PrimaryDarkBlueColor}"/>
        
        <Color x:Key="ActiveBlueAccentColor">#0B84F3</Color>
        <SolidColorBrush x:Key="ActiveBlueAccent" Color="{StaticResource ActiveBlueAccentColor}"/>
        
        <Color x:Key="LightBlueBackgroundColor">#F0F7FF</Color>
        <SolidColorBrush x:Key="LightBlueBackground" Color="{StaticResource LightBlueBackgroundColor}"/>
        
        <Color x:Key="LightBlueBorderColor">#D1E9FF</Color>
        <SolidColorBrush x:Key="LightBlueBorder" Color="{StaticResource LightBlueBorderColor}"/>
        
        <Color x:Key="GreenColor">#16A34A</Color>
        <SolidColorBrush x:Key="GreenStatus" Color="{StaticResource GreenColor}"/>
        
        <Color x:Key="OrangeColor">#D97706</Color>
        <SolidColorBrush x:Key="OrangeStatus" Color="{StaticResource OrangeColor}"/>
        
        <Color x:Key="RedColor">#EF4444</Color>
        <SolidColorBrush x:Key="RedStatus" Color="{StaticResource RedColor}"/>

        <Color x:Key="Slate900Color">#0F172A</Color>
        <SolidColorBrush x:Key="Slate900" Color="{StaticResource Slate900Color}"/>
        
        <Color x:Key="Slate800Color">#1E293B</Color>
        <SolidColorBrush x:Key="Slate800" Color="{StaticResource Slate800Color}"/>
        
        <Color x:Key="Slate700Color">#475569</Color>
        <SolidColorBrush x:Key="Slate700" Color="{StaticResource Slate700Color}"/>
        
        <Color x:Key="Slate500Color">#64748B</Color>
        <SolidColorBrush x:Key="Slate500" Color="{StaticResource Slate500Color}"/>
        
        <Color x:Key="BorderGrayColor">#E2E8F0</Color>
        <SolidColorBrush x:Key="BorderGray" Color="{StaticResource BorderGrayColor}"/>

        <!-- Style for Area Pill ListBox -->
        <Style x:Key="AreaPillListBox" TargetType="ListBox">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/>
            <Setter Property="ItemsPanel">
                <Setter.Value>
                    <ItemsPanelTemplate>
                        <WrapPanel Orientation="Horizontal"/>
                    </ItemsPanelTemplate>
                </Setter.Value>
            </Setter>
            <Setter Property="ItemContainerStyle">
                <Setter.Value>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="Background" Value="White"/>
                        <Setter Property="BorderBrush" Value="{StaticResource BorderGray}"/>
                        <Setter Property="BorderThickness" Value="1"/>
                        <Setter Property="Padding" Value="16,8"/>
                        <Setter Property="Margin" Value="0,0,10,10"/>
                        <Setter Property="Foreground" Value="{StaticResource Slate700}"/>
                        <Setter Property="FontWeight" Value="SemiBold"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListBoxItem">
                                    <Border Background="{TemplateBinding Background}" 
                                            BorderBrush="{TemplateBinding BorderBrush}" 
                                            BorderThickness="{TemplateBinding BorderThickness}" 
                                            CornerRadius="16">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter Property="Background" Value="{StaticResource PrimaryBlue}"/>
                                            <Setter Property="BorderBrush" Value="{StaticResource PrimaryBlue}"/>
                                            <Setter Property="Foreground" Value="White"/>
                                        </Trigger>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Cursor" Value="Hand"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Style for Status RadioButton -->
        <Style x:Key="StatusRadioButton" TargetType="RadioButton">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="border" Background="White" BorderBrush="{StaticResource BorderGray}" BorderThickness="1" CornerRadius="16" Margin="0,0,10,0" Padding="12,6">
                            <StackPanel Orientation="Horizontal">
                                <Ellipse x:Name="dot" Width="8" Height="8" Fill="{StaticResource Slate500}" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                <ContentPresenter VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="border" Property="BorderBrush" Value="{StaticResource PrimaryBlue}"/>
                                <Setter TargetName="border" Property="Background" Value="{StaticResource LightBlueBackground}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

            <!-- Areas & Search -->
            <Grid Grid.Row="0" Margin="0,0,0,15">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                
                <ListBox x:Name="lbAreas" Style="{StaticResource AreaPillListBox}" DisplayMemberPath="AreaName" SelectionChanged="LbAreas_SelectionChanged" Grid.Column="0"/>
                
                <Border Grid.Column="1" Background="White" BorderBrush="{StaticResource BorderGray}" BorderThickness="1" CornerRadius="8" Height="36" Width="220" VerticalAlignment="Top" Padding="10,0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="🔍" Foreground="{StaticResource Slate500}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <TextBox x:Name="txtKeyword" Grid.Column="1" BorderThickness="0" VerticalAlignment="Center" Background="Transparent" Foreground="{StaticResource Slate800}" TextChanged="TxtKeyword_TextChanged" Padding="0,2"/>
                    </Grid>
                </Border>
            </Grid>

            <!-- Status Filters -->
            <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,20">
                <RadioButton x:Name="rbStatusAll" Content="Tất cả trạng thái" GroupName="StatusFilter" IsChecked="True" Checked="FilterStatus_Checked" Style="{StaticResource StatusRadioButton}"/>
                
                <RadioButton x:Name="rbStatusAvailable" Content="Bàn trống" GroupName="StatusFilter" Checked="FilterStatus_Checked">
                    <RadioButton.Template>
                        <ControlTemplate TargetType="RadioButton">
                            <Border x:Name="border" Background="White" BorderBrush="{StaticResource BorderGray}" BorderThickness="1" CornerRadius="16" Margin="0,0,10,0" Padding="12,6">
                                <StackPanel Orientation="Horizontal">
                                    <Ellipse Width="8" Height="8" Fill="{StaticResource GreenStatus}" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                    <ContentPresenter VerticalAlignment="Center"/>
                                </StackPanel>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsChecked" Value="True">
                                    <Setter TargetName="border" Property="BorderBrush" Value="{StaticResource PrimaryBlue}"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </RadioButton.Template>
                </RadioButton>
                
                <RadioButton x:Name="rbStatusOccupied" Content="Đang có khách" GroupName="StatusFilter" Checked="FilterStatus_Checked">
                    <RadioButton.Template>
                        <ControlTemplate TargetType="RadioButton">
                            <Border x:Name="border" Background="White" BorderBrush="{StaticResource BorderGray}" BorderThickness="1" CornerRadius="16" Margin="0,0,10,0" Padding="12,6">
                                <StackPanel Orientation="Horizontal">
                                    <Ellipse Width="8" Height="8" Fill="{StaticResource PrimaryBlue}" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                    <ContentPresenter VerticalAlignment="Center"/>
                                </StackPanel>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsChecked" Value="True">
                                    <Setter TargetName="border" Property="BorderBrush" Value="{StaticResource PrimaryBlue}"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </RadioButton.Template>
                </RadioButton>
            </StackPanel>

            <!-- Table Cards -->
            <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
                <ItemsControl x:Name="icTables">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button Background="Transparent" BorderThickness="0" Margin="0,0,15,15" Click="TableCard_Click" Tag="{Binding}">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="cardBorder" Width="140" Height="140" Background="White" BorderBrush="{StaticResource BorderGray}" BorderThickness="1" CornerRadius="16" Padding="10">
                                            <Border.Effect>
                                                <DropShadowEffect Color="#E2E8F0" Direction="270" ShadowDepth="4" BlurRadius="10" Opacity="0.5"/>
                                            </Border.Effect>
                                            
                                            <Grid>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="2*"/>
                                                    <RowDefinition Height="3*"/>
                                                    <RowDefinition Height="2*"/>
                                                    <RowDefinition Height="2*"/>
                                                </Grid.RowDefinitions>
                                                
                                                <TextBlock x:Name="txtIcon" Grid.Row="0" Text="🪑" FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{StaticResource GreenStatus}"/>
                                                
                                                <TextBlock Grid.Row="1" FontSize="16" FontWeight="Bold" Foreground="{StaticResource Slate900}" HorizontalAlignment="Center" VerticalAlignment="Center" TextWrapping="Wrap" TextAlignment="Center">
                                                    <Run Text="{Binding TableName, Mode=OneWay}"/>
                                                    <Run Text=" - "/>
                                                    <Run Text="{Binding AreaName, Mode=OneWay}"/>
                                                </TextBlock>
                                                
                                                <TextBlock x:Name="txtStatusText" Grid.Row="2" Text="{Binding Status}" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource GreenStatus}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                
                                                <TextBlock x:Name="txtUnpaid" Grid.Row="3" Text="{Binding UnpaidAmount, StringFormat=\{0:N0\}}" FontSize="12" FontWeight="Bold" Foreground="{StaticResource PrimaryBlue}" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed"/>
                                            </Grid>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <DataTrigger Binding="{Binding Status}" Value="Available">
                                                <Setter TargetName="txtIcon" Property="Foreground" Value="{StaticResource GreenStatus}"/>
                                                <Setter TargetName="txtStatusText" Property="Foreground" Value="{StaticResource GreenStatus}"/>
                                                <Setter TargetName="txtStatusText" Property="Text" Value="Trống"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding Status}" Value="Occupied">
                                                <Setter TargetName="txtIcon" Property="Foreground" Value="{StaticResource PrimaryBlue}"/>
                                                <Setter TargetName="txtStatusText" Property="Foreground" Value="{StaticResource PrimaryBlue}"/>
                                                <Setter TargetName="txtStatusText" Property="Text" Value="Đang có khách"/>
                                                <Setter TargetName="txtUnpaid" Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding Status}" Value="WaitingPayment">
                                                <Setter TargetName="txtIcon" Property="Foreground" Value="{StaticResource OrangeStatus}"/>
                                                <Setter TargetName="txtStatusText" Property="Foreground" Value="{StaticResource OrangeStatus}"/>
                                                <Setter TargetName="txtStatusText" Property="Text" Value="Chờ thanh toán"/>
                                                <Setter TargetName="txtUnpaid" Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="cardBorder" Property="BorderBrush" Value="{StaticResource LightBlueBorder}"/>
                                                <Setter TargetName="cardBorder" Property="Background" Value="{StaticResource LightBlueBackground}"/>
                                                <Setter Property="Cursor" Value="Hand"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
    </Grid>
</UserControl>
