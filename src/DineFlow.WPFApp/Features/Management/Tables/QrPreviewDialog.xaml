<Window x:Class="DineFlow.WPFApp.Features.Management.Tables.QrPreviewDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="QR Preview" Width="450" SizeToContent="Height"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize" ShowInTaskbar="False"
        Background="{StaticResource BackgroundGray}">
    
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Background="White" BorderBrush="{StaticResource BorderGray}" BorderThickness="0,0,0,1" Padding="20,15">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="📱" FontFamily="Segoe UI Emoji" FontSize="20" Margin="0,0,10,0"/>
                <TextBlock x:Name="txtTitle" Text="Mã QR Bàn" FontSize="18" FontWeight="Bold" Foreground="{StaticResource Slate900}"/>
            </StackPanel>
        </Border>

        <!-- Khu vực in QR -->
        <Border Grid.Row="1" Background="White" Margin="20" CornerRadius="12" Padding="25" BorderBrush="{StaticResource BorderGray}" BorderThickness="1" HorizontalAlignment="Center">
            <!-- Khu vực này sẽ được in -->
            <Border x:Name="printArea" Background="White" HorizontalAlignment="Center" VerticalAlignment="Center">
                <StackPanel>
                    <!-- Dành cho In (Ẩn đi lúc bình thường) -->
                    <TextBlock x:Name="txtPrintRestaurantName" Text="[Tên Nhà Hàng]" FontSize="16" FontWeight="Bold" Foreground="{StaticResource Slate900}" HorizontalAlignment="Center" Margin="0,10,0,20" Visibility="Collapsed"/>
                    
                    <Border BorderBrush="{StaticResource BorderGray}" BorderThickness="1" CornerRadius="8" Padding="15" Margin="0,10" Background="White" HorizontalAlignment="Center">
                        <Image x:Name="imgQrCode" Stretch="Uniform" Width="200" Height="200"/>
                    </Border>
                    
                    <!-- Dành cho In (Ẩn đi lúc bình thường) -->
                    <TextBlock x:Name="txtPrintTableName" Text="{Binding TableName}" FontSize="16" FontWeight="SemiBold" Foreground="{StaticResource Slate800}" HorizontalAlignment="Center" Margin="0,20,0,10" Visibility="Collapsed"/>
                    <TextBlock x:Name="txtPrintAdditionalInfo" Text="[Wifi Info]" FontSize="14" Foreground="{StaticResource Slate500}" HorizontalAlignment="Center" TextWrapping="Wrap" TextAlignment="Center" Margin="0,0,0,10" Visibility="Collapsed"/>
                </StackPanel>
            </Border>
        </Border>

        <!-- Footer Actions -->
        <Border Grid.Row="2" Background="White" BorderBrush="{StaticResource BorderGray}" BorderThickness="0,1,0,0" Padding="15,15,20,15">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="btnCopyUrl" Content="Copy URL" Style="{StaticResource OutlineButton}" MinWidth="100" Margin="0,0,10,0" Click="BtnCopy_Click"/>
                <Button Content="Đóng" Style="{StaticResource NeutralButton}" MinWidth="90" Margin="0,0,10,0" Click="BtnClose_Click"/>
                <Button x:Name="btnPrint" Content="In QR" Style="{StaticResource PrimaryButton}" MinWidth="100" Click="BtnPrint_Click"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
